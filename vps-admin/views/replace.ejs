<%- include('partials/header', { title: 'Replace Management', msg, currentPath }) %>

<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 flex items-center gap-2.5">
      <span>🔄 Replace Requests</span>
      <span class="text-xs font-mono font-bold bg-sky-50 text-sky-700 border border-sky-200 px-2.5 py-0.5 rounded-full shadow-xs">
        BASICTRICK Warranty Hub
      </span>
    </h1>
    <p class="text-xs text-slate-500 mt-1">Manage customer replacement claims, deliver replacement files/text directly to Telegram</p>
  </div>
  <div class="flex items-center gap-2">
    <form method="post" action="/replace/bulk/dedupe" class="inline"
          onsubmit="return confirm('Pending থেকে duplicate entries মুছে দেবে। নিশ্চিত?');">
      <button class="bg-amber-50 border border-amber-200 hover:bg-amber-100 text-amber-800 px-3.5 py-2 rounded-xl text-xs font-bold flex items-center gap-1.5 transition shadow-xs">
        <span>🧹</span> Dedupe Pending
      </button>
    </form>
    <% if (status === 'collected' && rows.length) { %>
      <form method="post" action="/replace/bulk/delete-collected" class="inline"
            onsubmit="return confirm('সব collected entries permanently মুছে যাবে। নিশ্চিত?');">
        <button class="bg-rose-50 border border-rose-200 hover:bg-rose-100 text-rose-700 px-3.5 py-2 rounded-xl text-xs font-bold transition shadow-xs">
          🗑️ Delete All Collected
        </button>
      </form>
    <% } %>
  </div>
</div>

<!-- Status Tabs -->
<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
  <a href="/replace?status=pending"
     class="p-4 rounded-2xl border transition relative overflow-hidden <%= status==='pending' ? 'bg-amber-50 border-amber-300 text-amber-900 shadow-sm font-bold' : 'bg-white border-sky-200 text-slate-600 hover:bg-sky-50 hover:text-sky-700 shadow-xs' %>">
    <div class="text-xs font-semibold uppercase tracking-wider">⏳ Pending Claims</div>
    <div class="text-2xl font-black mt-1 text-slate-900"><%= counts.pending %></div>
  </a>
  <a href="/replace?status=replaced"
     class="p-4 rounded-2xl border transition relative overflow-hidden <%= status==='replaced' ? 'bg-emerald-50 border-emerald-300 text-emerald-900 shadow-sm font-bold' : 'bg-white border-sky-200 text-slate-600 hover:bg-sky-50 hover:text-sky-700 shadow-xs' %>">
    <div class="text-xs font-semibold uppercase tracking-wider">✅ Replaced / Done</div>
    <div class="text-2xl font-black mt-1 text-slate-900"><%= counts.replaced || 0 %></div>
  </a>
  <a href="/replace?status=collected"
     class="p-4 rounded-2xl border transition relative overflow-hidden <%= status==='collected' ? 'bg-sky-50 border-sky-300 text-sky-900 shadow-sm font-bold' : 'bg-white border-sky-200 text-slate-600 hover:bg-sky-50 hover:text-sky-700 shadow-xs' %>">
    <div class="text-xs font-semibold uppercase tracking-wider">📦 Collected</div>
    <div class="text-2xl font-black mt-1 text-slate-900"><%= counts.collected %></div>
  </a>
  <a href="/replace?status=rejected"
     class="p-4 rounded-2xl border transition relative overflow-hidden <%= status==='rejected' ? 'bg-rose-50 border-rose-300 text-rose-900 shadow-sm font-bold' : 'bg-white border-sky-200 text-slate-600 hover:bg-sky-50 hover:text-sky-700 shadow-xs' %>">
    <div class="text-xs font-semibold uppercase tracking-wider">🚫 Rejected</div>
    <div class="text-2xl font-black mt-1 text-slate-900"><%= counts.rejected %></div>
  </a>
</div>

<!-- Category Filter Pills -->
<div class="flex flex-wrap items-center gap-2 mb-6 bg-white p-2.5 rounded-2xl border border-sky-100 shadow-xs">
  <span class="text-xs font-bold text-slate-500 uppercase tracking-wider px-2">Filter:</span>
  <a href="/replace?status=<%= status %>&cat=all<%= q ? '&q=' + encodeURIComponent(q) : '' %>"
     class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition <%= cat === 'all' ? 'bg-sky-600 text-white shadow-xs' : 'bg-slate-100 text-slate-700 hover:bg-sky-50 hover:text-sky-700' %>">
    All Categories
  </a>
  <a href="/replace?status=<%= status %>&cat=used<%= q ? '&q=' + encodeURIComponent(q) : '' %>"
     class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1.5 <%= cat === 'used' ? 'bg-amber-500 text-white shadow-xs' : 'bg-amber-50 text-amber-800 border border-amber-200 hover:bg-amber-100' %>">
    <span>🎬</span> 1000xxx Used (<%= counts.usedPending || 0 %>)
  </a>
  <a href="/replace?status=<%= status %>&cat=fresh<%= q ? '&q=' + encodeURIComponent(q) : '' %>"
     class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition <%= cat === 'fresh' ? 'bg-sky-600 text-white shadow-xs' : 'bg-slate-100 text-slate-700 hover:bg-sky-50 hover:text-sky-700' %>">
    Fresh IDs Only
  </a>
</div>

<!-- SELLER-WISE & DATE-WISE REPLACE REPORT -->
<% if ((typeof sellerReports !== 'undefined' && sellerReports.length) || (typeof dateReports !== 'undefined' && dateReports.length)) { %>
  <div class="bg-gradient-to-r from-sky-50 via-indigo-50/50 to-sky-50 border border-sky-200/90 rounded-2xl p-5 mb-6 shadow-xs">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
      <div>
        <h2 class="text-base font-extrabold text-slate-900 flex items-center gap-2">
          <span>📋</span>
          <span>Seller & Date Wise Replace Report (সেলার ও তারিখভিত্তিক ব্রোকেন রিপোর্ট)</span>
          <span class="bg-sky-600 text-white text-[11px] font-bold px-2 py-0.5 rounded-full">
            <%= (sellerReports || []).length %> Sellers
          </span>
        </h2>
        <p class="text-xs text-slate-600 mt-0.5">
          রিপ্লেস রিকোয়েস্টের ব্রোকেন UID গুলো সেলার অনুযায়ী <strong>61xxx</strong> ও <strong>1000xxx</strong> আলাদা ক্যাটাগরিতে এবং <strong>তারিখ অনুযায়ী</strong> সাজানো রয়েছে।
        </p>
      </div>

      <!-- Tab Switcher & Clear All -->
      <div class="flex items-center gap-2 shrink-0 flex-wrap">
        <div class="inline-flex bg-slate-100 p-1 rounded-xl border border-slate-200 shadow-2xs">
          <button type="button" id="btnReportSeller" onclick="switchReportTab('seller')"
                  class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-sky-600 text-white shadow-xs transition">
            <span>👤</span> Seller-wise View
          </button>
          <button type="button" id="btnReportDate" onclick="switchReportTab('date')"
                  class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-white text-slate-600 hover:text-slate-900 border border-slate-200 transition">
            <span>📅</span> Date-wise View
          </button>
        </div>

        <form method="post" action="/replace/seller-uids/clear-all" onsubmit="return confirm('⚠️ আপনি কি নিশ্চিত যে সকল সেলারের জমানো UID ক্লিয়ার করতে চান?');" class="inline m-0">
          <button type="submit" class="text-xs bg-white hover:bg-rose-50 text-slate-600 hover:text-rose-700 border border-slate-200 hover:border-rose-200 font-bold px-3 py-1.5 rounded-xl shadow-xs transition flex items-center gap-1.5">
            <span>🗑️</span> Clear All
          </button>
        </form>
      </div>
    </div>

    <!-- TAB 1: SELLER-WISE VIEW -->
    <div id="reportSellerView" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
      <% (sellerReports || []).forEach(function(sr, sIdx){ %>
        <div class="bg-white border border-sky-200 rounded-xl p-4 shadow-xs hover:border-sky-300 transition flex flex-col justify-between">
          <div>
            <!-- Seller Header -->
            <div class="flex items-center justify-between gap-2 mb-3">
              <div class="flex items-center gap-2 min-w-0">
                <span class="w-8 h-8 rounded-lg bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold text-sm shrink-0">
                  <%= sr.seller.slice(0, 1).toUpperCase() %>
                </span>
                <div class="min-w-0">
                  <div class="font-extrabold text-slate-900 text-sm truncate" title="<%= sr.seller %>">
                    <%= sr.seller %>
                  </div>
                  <div class="text-[11px] text-slate-500 font-medium">
                    <%= sr.requestCount %> Claims • <span class="text-indigo-600 font-bold"><%= sr.count %> Total Broken</span>
                  </div>
                </div>
              </div>
              <span class="bg-rose-50 text-rose-700 border border-rose-200 text-xs font-mono font-bold px-2 py-0.5 rounded-md">
                <%= sr.count %> pcs
              </span>
            </div>

            <!-- Series Badges / Breakdown -->
            <div class="flex flex-wrap gap-1.5 mb-3">
              <% if (sr.count1000 > 0) { %>
                <span class="bg-emerald-50 text-emerald-700 border border-emerald-200 text-[11px] font-mono font-bold px-2 py-0.5 rounded-md">
                  🟢 1000xxx: <%= sr.count1000 %> pcs
                </span>
              <% } %>
              <% if (sr.count61 > 0) { %>
                <span class="bg-purple-50 text-purple-700 border border-purple-200 text-[11px] font-mono font-bold px-2 py-0.5 rounded-md">
                  🟣 61xxx: <%= sr.count61 %> pcs
                </span>
              <% } %>
              <% if (sr.countOther > 0) { %>
                <span class="bg-slate-100 text-slate-700 border border-slate-200 text-[11px] font-mono font-bold px-2 py-0.5 rounded-md">
                  ⚪ Other: <%= sr.countOther %> pcs
                </span>
              <% } %>
            </div>

            <!-- 1000xxx Box (if present) -->
            <% if (sr.count1000 > 0) { %>
              <div class="mb-3 bg-emerald-50/40 border border-emerald-200/80 rounded-lg p-2.5">
                <div class="flex items-center justify-between mb-1.5">
                  <span class="text-[11px] font-bold text-emerald-800 flex items-center gap-1">
                    <span>🟢</span> 1000xxx Series (<%= sr.count1000 %> pcs)
                  </span>
                  <button type="button"
                          onclick="copySellerUids('<%= sr.seller.replace(/'/g, "\\'") %> (1000xxx)', <%= JSON.stringify(sr.uids1000Text) %>)"
                          class="text-[10px] bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-2 py-0.5 rounded transition">
                    📋 Copy 1000xxx
                  </button>
                </div>
                <div class="bg-white border border-emerald-100 rounded p-1.5 max-h-24 overflow-y-auto font-mono text-[10px] text-slate-700 select-all leading-tight">
                  <% sr.uids1000.forEach(function(u){ %>
                    <div><%= u %></div>
                  <% }) %>
                </div>
              </div>
            <% } %>

            <!-- 61xxx Box (if present) -->
            <% if (sr.count61 > 0) { %>
              <div class="mb-3 bg-purple-50/40 border border-purple-200/80 rounded-lg p-2.5">
                <div class="flex items-center justify-between mb-1.5">
                  <span class="text-[11px] font-bold text-purple-800 flex items-center gap-1">
                    <span>🟣</span> 61xxx Series (<%= sr.count61 %> pcs)
                  </span>
                  <button type="button"
                          onclick="copySellerUids('<%= sr.seller.replace(/'/g, "\\'") %> (61xxx)', <%= JSON.stringify(sr.uids61Text) %>)"
                          class="text-[10px] bg-purple-600 hover:bg-purple-700 text-white font-bold px-2 py-0.5 rounded transition">
                    📋 Copy 61xxx
                  </button>
                </div>
                <div class="bg-white border border-purple-100 rounded p-1.5 max-h-24 overflow-y-auto font-mono text-[10px] text-slate-700 select-all leading-tight">
                  <% sr.uids61.forEach(function(u){ %>
                    <div><%= u %></div>
                  <% }) %>
                </div>
              </div>
            <% } %>

            <!-- Date Breakdown Badges for this seller -->
            <% if (sr.dateBreakdown && sr.dateBreakdown.length) { %>
              <div class="mt-2 mb-3 bg-slate-50 border border-slate-200/80 rounded-lg p-2">
                <div class="text-[10px] font-bold text-slate-500 mb-1 flex items-center gap-1">
                  <span>📅</span> Date-wise Breakdown:
                </div>
                <div class="flex flex-wrap gap-1 text-[10px]">
                  <% sr.dateBreakdown.forEach(function(dbRow){ %>
                    <span class="bg-white border border-slate-200 px-1.5 py-0.5 rounded text-slate-700 font-mono">
                      <%= dbRow.date %>: <strong><%= dbRow.total %></strong>
                      <% if (dbRow.count1000 > 0 && dbRow.count61 > 0) { %>
                        (1000x:<%= dbRow.count1000 %>, 61x:<%= dbRow.count61 %>)
                      <% } %>
                    </span>
                  <% }) %>
                </div>
              </div>
            <% } %>
          </div>

          <!-- Actions Footer -->
          <div class="flex items-center gap-2 pt-2 border-t border-slate-100">
            <button type="button"
                    onclick="copySellerUids('<%= sr.seller.replace(/'/g, "\\'") %>', <%= JSON.stringify(sr.uidsText) %>)"
                    class="flex-1 bg-gradient-to-r from-sky-500 to-sky-600 hover:from-sky-600 hover:to-sky-700 text-white font-bold py-2 px-3 rounded-lg text-xs flex items-center justify-center gap-1.5 shadow-xs transition">
              <span>📋</span> Copy All (<%= sr.count %>)
            </button>
            <button type="button"
                    onclick="downloadSellerUids('<%= sr.seller.replace(/'/g, "\\'") %>', <%= JSON.stringify(sr.uidsText) %>)"
                    class="bg-white border border-sky-300 hover:bg-sky-50 text-sky-800 font-bold py-2 px-2.5 rounded-lg text-xs flex items-center justify-center gap-1 shadow-xs transition"
                    title="Download as .txt">
              <span>💾</span>
            </button>
            <form method="post" action="/replace/seller-uids/clear" onsubmit="return confirm('⚠️ আপনি কি নিশ্চিত যে <%= sr.seller.replace(/'/g, "\\'") %> এর <%= sr.count %>টি UID রিমুভ/ক্লিয়ার করতে চান?');" class="inline m-0">
              <input type="hidden" name="seller_name" value="<%= sr.seller %>" />
              <button type="submit"
                      class="bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 hover:border-rose-300 font-bold py-2 px-2.5 rounded-lg text-xs flex items-center justify-center gap-1 shadow-xs transition"
                      title="Clear / Remove this seller's UIDs">
                <span>🗑️</span> Remove
              </button>
            </form>
          </div>
        </div>
      <% }) %>
    </div>

    <!-- TAB 2: DATE-WISE VIEW -->
    <div id="reportDateView" class="hidden space-y-4">
      <% if (!dateReports || !dateReports.length) { %>
        <div class="bg-white border border-slate-200 rounded-xl p-6 text-center text-slate-500 text-xs">
          কোনো তারিখভিত্তিক ব্রোকেন UID পাওয়া যায়নি।
        </div>
      <% } else { %>
        <% dateReports.forEach(function(dr){ %>
          <div class="bg-white border border-indigo-200/80 rounded-xl p-4 shadow-xs">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 mb-3 border-b border-slate-100">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-sm font-extrabold text-slate-900 flex items-center gap-1.5">
                  <span>📅</span> <%= dr.date %>
                </span>
                <span class="bg-indigo-50 text-indigo-700 border border-indigo-200 font-mono text-xs font-bold px-2 py-0.5 rounded-md">
                  Total: <%= dr.total %> pcs
                </span>
                <% if (dr.count1000 > 0) { %>
                  <span class="bg-emerald-50 text-emerald-700 border border-emerald-200 font-mono text-xs font-bold px-2 py-0.5 rounded-md">
                    1000xxx: <%= dr.count1000 %>
                  </span>
                <% } %>
                <% if (dr.count61 > 0) { %>
                  <span class="bg-purple-50 text-purple-700 border border-purple-200 font-mono text-xs font-bold px-2 py-0.5 rounded-md">
                    61xxx: <%= dr.count61 %>
                  </span>
                <% } %>
              </div>
              <div>
                <button type="button"
                        onclick="copySellerUids('Date <%= dr.date %>', <%= JSON.stringify(dr.uidsText) %>)"
                        class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-3 py-1 rounded-lg text-xs flex items-center gap-1 shadow-xs transition">
                  <span>📋</span> Copy All for <%= dr.date %> (<%= dr.total %>)
                </button>
              </div>
            </div>

            <!-- Sellers Table for this Date -->
            <div class="overflow-x-auto">
              <table class="w-full text-left text-xs border-collapse">
                <thead>
                  <tr class="bg-slate-50 text-slate-600 font-semibold border-b border-slate-200">
                    <th class="py-2 px-3">Seller Name</th>
                    <th class="py-2 px-3">1000xxx Series</th>
                    <th class="py-2 px-3">61xxx Series</th>
                    <th class="py-2 px-3 text-center">Total Pcs</th>
                    <th class="py-2 px-3 text-right">Actions</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                  <% dr.sellers.forEach(function(ds){ %>
                    <tr class="hover:bg-slate-50/60 transition">
                      <td class="py-2.5 px-3 font-bold text-slate-800">
                        👤 <%= ds.seller %>
                      </td>
                      <td class="py-2.5 px-3 font-mono">
                        <% if (ds.count1000 > 0) { %>
                          <span class="text-emerald-700 font-bold"><%= ds.count1000 %> pcs</span>
                          <button type="button" onclick="copySellerUids('<%= ds.seller %> <%= dr.date %> (1000xxx)', <%= JSON.stringify(ds.uids1000Text) %>)"
                                  class="ml-1.5 text-[10px] bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 px-1.5 py-0.5 rounded transition">
                            Copy
                          </button>
                        <% } else { %>
                          <span class="text-slate-400">—</span>
                        <% } %>
                      </td>
                      <td class="py-2.5 px-3 font-mono">
                        <% if (ds.count61 > 0) { %>
                          <span class="text-purple-700 font-bold"><%= ds.count61 %> pcs</span>
                          <button type="button" onclick="copySellerUids('<%= ds.seller %> <%= dr.date %> (61xxx)', <%= JSON.stringify(ds.uids61Text) %>)"
                                  class="ml-1.5 text-[10px] bg-purple-50 hover:bg-purple-100 text-purple-800 border border-purple-200 px-1.5 py-0.5 rounded transition">
                            Copy
                          </button>
                        <% } else { %>
                          <span class="text-slate-400">—</span>
                        <% } %>
                      </td>
                      <td class="py-2.5 px-3 text-center font-mono font-extrabold text-slate-900">
                        <%= ds.total %> pcs
                      </td>
                      <td class="py-2.5 px-3 text-right">
                        <button type="button"
                                onclick="copySellerUids('<%= ds.seller %> <%= dr.date %> (Total)', <%= JSON.stringify(ds.uidsText) %>)"
                                class="bg-sky-50 hover:bg-sky-100 text-sky-700 border border-sky-200 font-bold px-2.5 py-1 rounded-lg text-xs transition">
                          📋 Copy (<%= ds.total %>)
                        </button>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>
<% } %>

<form id="bulkActionForm" method="post" action="/replace/bulk/delete-selected">
<!-- Bulk Action Toolbar & Search Bar -->
<div class="mb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
  <!-- Search -->
  <div class="flex gap-2 flex-1 max-w-lg">
    <input type="hidden" name="status" value="<%= status %>"/>
    <input type="hidden" name="cat" value="<%= cat %>"/>
    <input name="q" value="<%= q %>" placeholder="Search by User ID, @username, or Account data..."
      class="w-full bg-white border border-sky-200 focus:border-sky-500 focus:ring-2 focus:ring-sky-100 rounded-xl px-4 py-2.5 text-xs placeholder-slate-400 text-slate-800 outline-none transition shadow-xs"/>
    <button type="submit" form="searchForm" class="bg-gradient-to-r from-sky-500 to-sky-600 hover:from-sky-600 hover:to-sky-700 text-white font-bold px-4 py-2 rounded-xl text-xs transition shadow-xs">
      Search
    </button>
    <% if (q) { %>
      <a href="/replace?status=<%= status %>&cat=<%= cat %>" class="px-3 py-2 text-xs text-slate-600 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 rounded-xl transition flex items-center">
        Clear
      </a>
    <% } %>
  </div>

  <!-- Bulk Selection Actions -->
  <div class="flex items-center gap-2">
    <button type="button" id="btnDeleteSelected" onclick="submitDeleteSelected()"
            class="hidden bg-rose-600 hover:bg-rose-500 text-white font-bold px-4 py-2 rounded-xl text-xs shadow-md shadow-rose-600/30 items-center gap-1.5 transition">
      <span>🗑️</span> Delete Selected (<span id="selectedCount">0</span>)
    </button>
    <button type="button" onclick="confirmClearAll('<%= status %>')"
            class="bg-rose-50 border border-rose-200 hover:bg-rose-100 text-rose-700 font-bold px-3.5 py-2 rounded-xl text-xs flex items-center gap-1.5 transition shadow-xs">
      <span>💥</span> Clear All <%= status.toUpperCase() %>
    </button>
  </div>
</div>

<!-- Table Container -->
<div class="commercial-card rounded-2xl overflow-hidden bg-white border border-sky-200 shadow-sm">
  <div class="overflow-x-auto">
  <table class="w-full text-xs">
    <thead>
      <tr class="border-b border-sky-100 bg-sky-50/90 text-sky-800 font-mono text-[11px] tracking-wider uppercase font-bold">
        <th class="py-3.5 px-4 w-10 text-center">
          <input type="checkbox" id="selectAllCheckbox" onclick="toggleSelectAll(this)"
                 class="w-4 h-4 rounded bg-white border-slate-300 text-sky-600 focus:ring-sky-500 cursor-pointer"/>
        </th>
        <th class="py-3.5 px-3">ID</th>
        <th class="py-3.5 px-4">User</th>
        <th class="py-3.5 px-4">Category</th>
        <th class="py-3.5 px-4">Broken Accounts (Old Data)</th>
        <% if (status === 'replaced') { %>
          <th class="py-3.5 px-4">Replacement Provided</th>
          <th class="py-3.5 px-4">Resolved By / Date (BDT Dhaka)</th>
        <% } else { %>
          <th class="py-3.5 px-4">Reason / Note</th>
          <th class="py-3.5 px-4">Submitted (BDT Dhaka)</th>
        <% } %>
        <th class="py-3.5 px-4 text-right">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-sky-100">
      <% if (!rows.length) { %>
        <tr>
          <td colspan="8" class="text-center text-slate-400 py-12">
            <div class="text-3xl mb-2">📭</div>
            <div class="font-medium">এই ক্যাটাগরিতে কোনো রিকোয়েস্ট পাওয়া যায়নি।</div>
          </td>
        </tr>
      <% } %>
      <% rows.forEach(function(r){ %>
        <tr class="hover:bg-sky-50/50 transition">
          <td class="py-3 px-4 text-center">
            <input type="checkbox" name="selected_ids" value="<%= r.id %>" onclick="updateSelectedCount()"
                   class="row-checkbox w-4 h-4 rounded bg-white border-slate-300 text-sky-600 focus:ring-sky-500 cursor-pointer"/>
          </td>
          <td class="py-3 px-3 font-mono text-slate-400 font-bold">#<%= r.id %></td>
          <td class="py-3 px-4">
            <a href="/users/<%= r.user_id %>" class="text-slate-900 hover:text-sky-600 font-semibold block transition">
              <%= r.username || 'User' %>
            </a>
            <div class="text-[11px] text-slate-400 font-mono">ID: `<%= r.user_id %>`</div>
          </td>
          <td class="py-3 px-4">
            <% if ((r.category || '').toLowerCase().includes('used')) { %>
              <span class="inline-flex items-center gap-1 bg-amber-50 border border-amber-300 text-amber-900 font-mono text-xs px-2.5 py-1 rounded-lg font-extrabold shadow-xs">
                <span>🎬</span> 1000xxx Used
              </span>
              <div class="text-[10px] text-amber-700 font-bold mt-0.5">⏱️ 2h Limit</div>
            <% } else { %>
              <span class="inline-block bg-sky-50 border border-sky-200 text-sky-700 font-mono text-xs px-2.5 py-0.5 rounded-lg font-bold">
                <%= r.category || 'ID' %>
              </span>
            <% } %>
          </td>
          <td class="py-3 px-4 align-top">
            <% if (r.primarySeller) { %>
              <div class="inline-flex items-center gap-1 bg-indigo-50 border border-indigo-200 text-indigo-800 text-[10px] font-bold px-2 py-0.5 rounded-md mb-1.5 shadow-2xs">
                <span>👤</span> Seller: <%= r.sellers.join(', ') %>
              </div>
            <% } %>
            <div class="font-mono text-xs text-slate-700 max-w-xs md:max-w-sm truncate">
              <%= (r.old_data || '-').split('\n')[0].slice(0, 55) %>
            </div>
            <% if (r.detectedUids && r.detectedUids.length) { %>
              <div class="flex flex-wrap gap-1 mt-1.5">
                <% r.detectedUids.slice(0, 3).forEach(function(u){ %>
                  <span class="bg-slate-100 hover:bg-sky-50 text-slate-700 hover:text-sky-700 border border-slate-200 font-mono text-[10px] px-1.5 py-0.2 rounded cursor-pointer transition"
                        onclick="navigator.clipboard.writeText('<%= u %>'); alert('Copied UID: <%= u %>');"
                        title="Click to copy UID">
                    <%= u %>
                  </span>
                <% }) %>
                <% if (r.detectedUids.length > 3) { %>
                  <span class="text-[10px] text-slate-400 font-medium">+<%= r.detectedUids.length - 3 %> more</span>
                <% } %>
              </div>
            <% } %>
            <button type="button" class="mt-1.5 text-[11px] text-sky-600 hover:text-sky-800 font-bold flex items-center gap-1"
                    onclick="openViewer(<%= r.id %>)">
              <span>🔍</span> See Full Details (<%= (r.old_data || '').split('\n').filter(Boolean).length %> accounts)
            </button>
          </td>

          <% if (status === 'replaced') { %>
            <td class="py-3 px-4 align-top">
              <% if (r.replacement_file) { %>
                <div class="inline-flex items-center gap-1.5 bg-sky-50 border border-sky-200 text-sky-700 px-2.5 py-1 rounded-lg text-xs font-mono font-bold">
                  <span>📄</span> <%= r.replacement_file %>
                </div>
              <% } %>
              <% if (r.replacement_data) { %>
                <div class="font-mono text-xs text-emerald-600 max-w-xs truncate mt-1">
                  <%= r.replacement_data.split('\n')[0].slice(0, 50) %>
                </div>
                <button type="button" class="text-[11px] text-emerald-600 font-bold hover:underline" onclick="openViewer(<%= r.id %>, 'replacement')">
                  🔍 View Replaced Data
                </button>
              <% } %>
            </td>
            <td class="py-3 px-4 text-xs text-slate-500">
              <span class="text-slate-800 font-semibold"><%= r.resolved_by || 'admin' %></span>
              <div class="text-[11px] text-slate-400 font-mono"><%= typeof formatDateTime === 'function' ? formatDateTime(r.resolved_at) : (r.resolved_at ? new Date(r.resolved_at).toLocaleString('en-GB', { timeZone: 'Asia/Dhaka', hour12: true }) : '-') %></div>
            </td>
          <% } else { %>
            <td class="py-3 px-4 text-slate-600 text-xs max-w-xs">
              <div class="font-bold text-slate-800 flex items-center gap-1.5 flex-wrap">
                <%= r.reason || '-' %>
                <% if (r._isReReplace) { %>
                  <span class="inline-flex items-center gap-1 bg-amber-100 text-amber-800 border border-amber-300 px-2 py-0.5 rounded-md text-[10px] font-bold">
                    🔄 রি-রিপ্লেস (পূর্বের রিপ্লেস নষ্ট)
                  </span>
                <% } %>
              </div>
              <% if (r._orderPurchasedTime) { %>
                <div class="mt-1.5 text-[11px] space-y-1 font-mono bg-sky-50/80 border border-sky-200/80 p-2 rounded-xl">
                  <div class="text-slate-600 flex items-center justify-between">
                    <span><%= r._isReReplace && r._lastReplacedTime ? '🔄 রিপ্লেস প্রদান:' : '🛒 কেনা:' %> <strong class="text-slate-800"><%= r._isReReplace && r._lastReplacedTime ? r._lastReplacedTime : r._orderPurchasedTime %></strong></span>
                    <span class="text-[10px] text-slate-500">(<%= r._orderQty %> pcs)</span>
                  </div>
                  <div class="flex items-center justify-between pt-0.5 border-t border-sky-100">
                    <span class="text-slate-600 font-semibold">⏱️ সময়: <%= r._orderElapsed %> (সীমা: <%= r._orderWindow %>)</span>
                    <span class="px-1.5 py-0.2 rounded-full font-bold text-[10px] <%= r._orderWindowStatus === 'valid' ? 'bg-emerald-100 text-emerald-800 border border-emerald-300' : 'bg-rose-100 text-rose-800 border border-rose-300' %>">
                      <%= r._orderWindowStatus === 'valid' ? '✓ ইন-টাইম' : '⚠ এক্সপায়ার্ড' %>
                    </span>
                  </div>
                </div>
              <% } %>
            </td>
            <td class="py-3 px-4 text-slate-600 text-xs font-mono font-medium whitespace-nowrap">
              <%= typeof formatDateTime === 'function' ? formatDateTime(r.created_at) : new Date(r.created_at).toLocaleString('en-GB', { timeZone: 'Asia/Dhaka', hour12: true }) %>
            </td>
          <% } %>

          <td class="py-3 px-4 text-right space-x-1 whitespace-nowrap">
            <% if (r.status === 'pending') { %>
              <button type="button" class="bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-600 hover:to-emerald-700 text-white font-bold px-3 py-1.5 rounded-xl text-xs shadow-xs transition"
                      onclick="openResolveModal(<%= r.id %>, '<%= r.user_id %>', '<%- (r.username || 'User').replace(/'/g, '') %>', '<%- (r.category || 'fb1000').replace(/'/g, '') %>', <%= (r.old_data || '').split('\n').filter(Boolean).length || 1 %>)">
                🔄 Give Replace
              </button>
              <button type="button" onclick="openReplyModal(<%= r.id %>, '<%= r.user_id %>', '<%- (r.username || 'User').replace(/'/g, '') %>', '<%- (r.category || '').replace(/'/g, '') %>')"
                      class="bg-sky-50 hover:bg-sky-100 text-sky-700 border border-sky-200 px-2.5 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1">
                <span>✉️</span> Reply
              </button>
              <button type="button" class="bg-rose-50 border border-rose-200 hover:bg-rose-100 text-rose-700 px-2.5 py-1.5 rounded-xl text-xs font-bold transition"
                      onclick="openRejectModal(<%= r.id %>)">
                🚫 Reject
              </button>
            <% } %>
            <button type="button" onclick="submitDeleteSingle(<%= r.id %>)" class="text-slate-400 hover:text-rose-600 p-1.5 rounded-lg text-xs transition" title="Delete">
              🗑️
            </button>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  </div>
</div>
</form>

<!-- Dedicated Hidden Forms for Single Actions (Prevents nested form issues) -->
<form id="searchForm" method="get" action="/replace" class="hidden">
  <input type="hidden" name="status" value="<%= status %>"/>
  <input type="hidden" name="cat" value="<%= cat %>"/>
  <input type="hidden" name="q" id="searchQVal" value="<%= q %>"/>
</form>
<form id="singleActionForm" method="post" class="hidden"></form>
<form id="clearAllForm" method="post" action="/replace/bulk/clear-all" class="hidden">
  <input type="hidden" name="status" id="clearAllStatus" value="<%= status %>"/>
</form>

<!-- ================= MODAL 1: GIVE REPLACE (STOCK AUTO-FETCH, FILE, OR TEXT) ================= -->
<div id="resolveModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/40 backdrop-blur-xs p-4">
  <div class="w-full max-w-xl bg-white border border-sky-200 rounded-3xl shadow-2xl overflow-hidden">
    <div class="flex items-center justify-between px-6 py-4 border-b border-sky-100 bg-sky-50/80">
      <div>
        <div class="text-base font-bold text-slate-900 flex items-center gap-2">
          <span>🔄 Give Replacement</span>
          <span id="resModalId" class="text-sky-600 font-mono text-sm font-bold"></span>
          <span id="resModalCategory" class="text-xs font-mono font-bold px-2 py-0.5 rounded-lg bg-sky-100 text-sky-800"></span>
        </div>
        <div class="text-xs text-slate-500 mt-0.5">To: <span id="resModalUser" class="text-slate-800 font-bold"></span></div>
      </div>
      <button onclick="closeResolveModal()" class="text-slate-400 hover:text-slate-700 text-lg p-1">✕</button>
    </div>

    <form id="resolveForm" method="post" enctype="multipart/form-data" class="p-6 space-y-4">
      <!-- Option 1: Live Stock Auto-Fetch -->
      <div class="p-4 bg-emerald-50/70 border border-emerald-200 rounded-2xl">
        <div class="flex items-center justify-between">
          <label class="flex items-center gap-2 cursor-pointer font-bold text-xs text-emerald-950">
            <input type="checkbox" id="use_stock_toggle" name="use_stock" value="1" onchange="toggleStockOption(this.checked)"
                   class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 cursor-pointer"/>
            <span>⚡ Auto-Fetch from Live Stock (লাইভ স্টক থেকে সরাসরি কাটুন)</span>
          </label>
        </div>

        <div id="stockOptionBody" class="hidden mt-3 pt-3 border-t border-emerald-200/70 grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-[11px] font-bold text-emerald-950 uppercase mb-1">ক্যাটাগরি সিলেক্ট করুন:</label>
            <select name="stock_category" id="modalStockCategory" class="w-full bg-white border border-emerald-300 rounded-xl px-3 py-2 text-xs font-semibold text-slate-800 outline-none focus:ring-2 focus:ring-emerald-400">
              <option value="fb1000_used">🎬 1000xxx Used (স্টক: <%= (stockCounts && stockCounts.fb1000_used) || 0 %>)</option>
              <option value="fb1000">💎 1000xxx Fresh (স্টক: <%= (stockCounts && stockCounts.fb1000) || 0 %>)</option>
              <option value="fb61">⚡ 61xxx Clon (স্টক: <%= (stockCounts && stockCounts.fb61) || 0 %>)</option>
            </select>
          </div>
          <div>
            <label class="block text-[11px] font-bold text-emerald-950 uppercase mb-1">পরিমাণ (Quantity):</label>
            <input type="number" name="stock_qty" id="modalStockQty" min="1" value="1"
                   class="w-full bg-white border border-emerald-300 rounded-xl px-3 py-2 text-xs font-bold text-slate-800 outline-none focus:ring-2 focus:ring-emerald-400"/>
          </div>
        </div>
      </div>

      <div class="relative flex items-center justify-center">
        <div class="border-t border-slate-200 w-full"></div>
        <div class="bg-white px-3 text-xs text-slate-400 uppercase tracking-widest absolute font-bold">OR (MANUAL)</div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
          Option 2: Upload Replacement File (.txt or .xlsx)
        </label>
        <input type="file" name="replace_file" accept=".txt,.xlsx,.csv"
               class="w-full text-xs text-slate-600 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-sky-100 file:text-sky-700 hover:file:bg-sky-200 file:cursor-pointer border border-dashed border-sky-200 rounded-xl p-3 bg-slate-50"/>
        <p class="text-[11px] text-slate-500 mt-1">ফাইল সিলেক্ট করলে এটি সরাসরি ইউজারের টেলিগ্রামে চলে যাবে।</p>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-2">
          Option 3: Paste New Account Data (UID PASS COOKIES)
        </label>
        <textarea name="replacement_text" rows="4" placeholder="1000... password123 datr=...&#10;1000... password456 datr=..."
                  class="w-full bg-slate-50 border border-slate-200 focus:border-sky-500 focus:bg-white rounded-xl p-3 font-mono text-xs text-slate-800 placeholder-slate-400 outline-none"></textarea>
      </div>

      <div class="pt-2 flex justify-end gap-3">
        <button type="button" onclick="closeResolveModal()" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-500 hover:bg-slate-100">
          Cancel
        </button>
        <button type="submit" class="bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-600 hover:to-emerald-700 text-white font-bold px-6 py-2.5 rounded-xl text-xs shadow-md shadow-emerald-600/25 flex items-center gap-2">
          <span>🚀</span> Send Replacement to User
        </button>
      </div>
    </form>
  </div>
</div>

<!-- ================= MODAL 2: FULL DATA VIEWER (ASYNC) ================= -->
<div id="viewerModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/40 backdrop-blur-xs p-4">
  <div class="w-full max-w-2xl bg-white border border-sky-200 rounded-3xl shadow-2xl overflow-hidden">
    <div class="flex items-center justify-between px-6 py-4 border-b border-sky-100 bg-sky-50/80">
      <div>
        <div class="text-sm font-bold text-slate-900 flex items-center gap-2">
          <span id="viewerTitle">Replace Details</span>
          <span id="viewerId" class="text-sky-600 font-mono font-bold"></span>
        </div>
        <div id="viewerSub" class="text-xs text-slate-500"></div>
      </div>
      <div class="flex gap-2">
        <button onclick="copyViewerText()" class="bg-sky-100 hover:bg-sky-200 text-sky-800 px-3.5 py-1.5 rounded-xl text-xs font-bold flex items-center gap-1">
          <span>📋</span> Copy All
        </button>
        <button onclick="closeViewer()" class="text-slate-400 hover:text-slate-700 text-base p-1">✕</button>
      </div>
    </div>
    <div class="p-6">
      <pre id="viewerContent" class="p-4 max-h-[60vh] overflow-auto whitespace-pre-wrap break-all font-mono text-xs text-slate-800 bg-slate-50 border border-slate-200 rounded-2xl leading-relaxed"></pre>
    </div>
  </div>
</div>

<!-- ================= MODAL 3: REJECT REASON ================= -->
<div id="rejectModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/40 backdrop-blur-xs p-4">
  <div class="w-full max-w-md bg-white border border-sky-200 rounded-3xl shadow-2xl p-6">
    <h3 class="text-base font-bold text-slate-900 mb-2">🚫 Reject Replace Request</h3>
    <p class="text-xs text-slate-500 mb-4">User কে বাতিল করার কারণসহ নোটিফিকেশন মেসেজ পাঠানো হবে।</p>
    <form id="rejectForm" method="post" class="space-y-4">
      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1">Reason (ঐচ্ছিক):</label>
        <input name="reject_reason" placeholder="যেমন: 2 ঘণ্টার টাইম লিমিট পার হয়েছে"
               class="w-full bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs text-slate-800 outline-none focus:border-rose-500 focus:bg-white"/>
      </div>
      <div class="flex justify-end gap-2 pt-2">
        <button type="button" onclick="closeRejectModal()" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-500 hover:bg-slate-100">Cancel</button>
        <button type="submit" class="bg-rose-600 hover:bg-rose-500 text-white font-bold px-4 py-2 rounded-xl text-xs shadow-xs">Confirm Reject</button>
      </div>
    </form>
  </div>
</div>

<!-- ================= MODAL 4: REPLY TO USER WITH MESSAGE & SCREENSHOT ================= -->
<div id="replyModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-900/40 backdrop-blur-xs p-4">
  <div class="w-full max-w-lg bg-white border border-sky-200 rounded-3xl shadow-2xl p-6">
    <div class="flex items-center justify-between border-b border-sky-100 pb-3 mb-4">
      <div>
        <h3 class="text-base font-extrabold text-slate-900 flex items-center gap-2">
          <span>✉️</span> Reply to User
          <span id="replyModalId" class="text-sky-600 font-mono font-bold"></span>
        </h3>
        <p class="text-xs text-slate-500 mt-0.5">
          User: <span id="replyModalUser" class="font-bold text-slate-700"></span>
        </p>
      </div>
      <button type="button" onclick="closeReplyModal()" class="text-slate-400 hover:text-slate-700 text-base p-1">✕</button>
    </div>

    <form id="replyForm" method="post" enctype="multipart/form-data" class="space-y-4">
      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1">
          💬 Message (বার্তা):
        </label>
        <textarea name="reply_message" id="replyMessageText" rows="4" placeholder="ইউজারকে আপনার মেসেজ লিখুন (যেমন: আপনার সমস্যাটি চেক করা হয়েছে...)"
                  class="w-full bg-slate-50 border border-slate-200 rounded-xl p-3 text-xs text-slate-800 outline-none focus:border-sky-500 focus:bg-white placeholder-slate-400"></textarea>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 mb-1">
          🖼️ Screenshot / File Attachment (ঐচ্ছিক):
        </label>
        <input type="file" name="reply_file" accept="image/*,.txt,.pdf,.xlsx,.csv,.zip"
               class="w-full text-xs text-slate-600 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-sky-100 file:text-sky-700 hover:file:bg-sky-200 file:cursor-pointer border border-dashed border-sky-200 rounded-xl p-3 bg-slate-50"/>
        <p class="text-[11px] text-slate-500 mt-1">📸 স্ক্রিনশট বা ফাইল সিলেক্ট করলে এটি ইউজারের টেলিগ্রামে সরাসরি চলে যাবে।</p>
      </div>

      <div class="flex justify-end gap-2 pt-2 border-t border-slate-100">
        <button type="button" onclick="closeReplyModal()" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-500 hover:bg-slate-100">
          Cancel
        </button>
        <button type="submit" class="bg-gradient-to-r from-sky-600 to-indigo-600 hover:from-sky-700 hover:to-indigo-700 text-white font-bold px-5 py-2.5 rounded-xl text-xs shadow-md shadow-sky-600/20 flex items-center gap-1.5">
          <span>🚀</span> Send Reply & Screenshot
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function toggleSelectAll(master) {
    var boxes = document.querySelectorAll('.row-checkbox');
    boxes.forEach(function(b){ b.checked = master.checked; });
    updateSelectedCount();
  }

  function updateSelectedCount() {
    var checked = document.querySelectorAll('.row-checkbox:checked');
    var count = checked.length;
    document.getElementById('selectedCount').textContent = count;
    var btn = document.getElementById('btnDeleteSelected');
    if (count > 0) {
      btn.classList.remove('hidden');
      btn.classList.add('flex');
    } else {
      btn.classList.add('hidden');
      btn.classList.remove('flex');
    }
  }

  function submitDeleteSelected() {
    var checked = document.querySelectorAll('.row-checkbox:checked');
    if (!checked.length) return alert('কোনো রিকোয়েস্ট সিলেক্ট করা হয়নি!');
    if (!confirm('সিলেক্ট করা ' + checked.length + ' টি রিকোয়েস্ট পার্মানেন্টলি ডিলিট করতে চান?')) return;
    document.getElementById('bulkActionForm').submit();
  }

  function confirmClearAll(status) {
    if (!confirm('সতর্কতা: ' + status.toUpperCase() + ' স্ট্যাটাসের সব রিকোয়েস্ট মুছে ফেলা হবে। নিশ্চিত?')) return;
    document.getElementById('clearAllStatus').value = status;
    document.getElementById('clearAllForm').submit();
  }

  function submitCollect(id) {
    var f = document.getElementById('singleActionForm');
    f.action = '/replace/' + id + '/collect';
    f.submit();
  }

  function submitDeleteSingle(id) {
    if (!confirm('Permanently delete record #' + id + '?')) return;
    var f = document.getElementById('singleActionForm');
    f.action = '/replace/' + id + '/delete';
    f.submit();
  }

  function openResolveModal(id, uid, uname, category, qty) {
    document.getElementById('resModalId').textContent = '#' + id;
    document.getElementById('resModalUser').textContent = uname + ' (' + uid + ')';
    var catBadge = document.getElementById('resModalCategory');
    if (catBadge) {
      catBadge.textContent = category || 'ID';
    }
    document.getElementById('resolveForm').action = '/replace/' + id + '/resolve';

    // Auto configure category and qty for live stock fetch
    var catSelect = document.getElementById('modalStockCategory');
    if (catSelect) {
      var catStr = (category || '').toLowerCase();
      if (catStr.includes('used')) {
        catSelect.value = 'fb1000_used';
      } else if (catStr.includes('61')) {
        catSelect.value = 'fb61';
      } else {
        catSelect.value = 'fb1000';
      }
    }
    var qtyInput = document.getElementById('modalStockQty');
    if (qtyInput) {
      qtyInput.value = qty || 1;
    }
    // Uncheck stock toggle by default
    var stockToggle = document.getElementById('use_stock_toggle');
    if (stockToggle) {
      stockToggle.checked = false;
      toggleStockOption(false);
    }

    var m = document.getElementById('resolveModal');
    m.classList.remove('hidden'); m.classList.add('flex');
  }

  function toggleStockOption(enabled) {
    var body = document.getElementById('stockOptionBody');
    if (body) {
      if (enabled) {
        body.classList.remove('hidden');
      } else {
        body.classList.add('hidden');
      }
    }
  }

  function closeResolveModal() {
    var m = document.getElementById('resolveModal');
    m.classList.add('hidden'); m.classList.remove('flex');
  }

  function openRejectModal(id) {
    document.getElementById('rejectForm').action = '/replace/' + id + '/reject';
    var m = document.getElementById('rejectModal');
    m.classList.remove('hidden'); m.classList.add('flex');
  }
  function closeRejectModal() {
    var m = document.getElementById('rejectModal');
    m.classList.add('hidden'); m.classList.remove('flex');
  }

  function openReplyModal(id, uid, uname, category) {
    document.getElementById('replyModalId').textContent = '#' + id;
    document.getElementById('replyModalUser').textContent = uname + ' (' + uid + ')';
    document.getElementById('replyForm').action = '/replace/' + id + '/reply';
    document.getElementById('replyMessageText').value = '';
    var m = document.getElementById('replyModal');
    m.classList.remove('hidden'); m.classList.add('flex');
  }

  function closeReplyModal() {
    var m = document.getElementById('replyModal');
    m.classList.add('hidden'); m.classList.remove('flex');
  }

  function openViewer(id, field) {
    document.getElementById('viewerId').textContent = '#' + id;
    document.getElementById('viewerContent').textContent = 'Loading full data...';
    var m = document.getElementById('viewerModal');
    m.classList.remove('hidden'); m.classList.add('flex');

    fetch('/replace/' + id + '/data')
      .then(function(r){ return r.json(); })
      .then(function(json){
        if (!json.ok) return alert('Failed to load data');
        var row = json.data;
        if (field === 'replacement') {
          document.getElementById('viewerTitle').textContent = '✅ Provided Replacement Data';
          document.getElementById('viewerSub').textContent = 'Sent by ' + (row.resolved_by || 'admin');
          document.getElementById('viewerContent').textContent = row.replacement_data || '(No text data)';
        } else {
          document.getElementById('viewerTitle').textContent = '📋 Broken Accounts Claimed by User';
          document.getElementById('viewerSub').textContent = (row.username || 'User') + ' (' + row.user_id + ')';
          document.getElementById('viewerContent').textContent = row.old_data || '(No data)';
        }
      })
      .catch(function(err){
        document.getElementById('viewerContent').textContent = 'Error loading data: ' + err.message;
      });
  }
  function closeViewer() {
    var m = document.getElementById('viewerModal');
    m.classList.add('hidden'); m.classList.remove('flex');
  }
  function switchReportTab(tab) {
    var sellerView = document.getElementById('reportSellerView');
    var dateView = document.getElementById('reportDateView');
    var btnSeller = document.getElementById('btnReportSeller');
    var btnDate = document.getElementById('btnReportDate');
    if (!sellerView || !dateView) return;
    if (tab === 'date') {
      sellerView.classList.add('hidden');
      dateView.classList.remove('hidden');
      if (btnDate) btnDate.className = "px-3.5 py-1.5 rounded-xl text-xs font-bold bg-sky-600 text-white shadow-xs transition";
      if (btnSeller) btnSeller.className = "px-3.5 py-1.5 rounded-xl text-xs font-bold bg-white text-slate-600 hover:text-slate-900 border border-slate-200 transition";
    } else {
      dateView.classList.add('hidden');
      sellerView.classList.remove('hidden');
      if (btnSeller) btnSeller.className = "px-3.5 py-1.5 rounded-xl text-xs font-bold bg-sky-600 text-white shadow-xs transition";
      if (btnDate) btnDate.className = "px-3.5 py-1.5 rounded-xl text-xs font-bold bg-white text-slate-600 hover:text-slate-900 border border-slate-200 transition";
    }
  }

  function copySellerUids(sellerName, uidsText) {
    if (!uidsText) return alert('কোনো UID পাওয়া যায়নি');
    var count = uidsText.split('\n').filter(Boolean).length;
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(uidsText).then(function(){
        alert('✅ ' + sellerName + ' এর ' + count + ' টি UID ক্লিপবোর্ডে কপি করা হয়েছে!');
      }).catch(function(){
        fallbackCopyText(uidsText, sellerName, count);
      });
    } else {
      fallbackCopyText(uidsText, sellerName, count);
    }
  }

  function fallbackCopyText(text, sellerName, count) {
    var ta = document.createElement('textarea');
    ta.value = text;
    document.body.appendChild(ta);
    ta.select();
    document.execCommand('copy');
    document.body.removeChild(ta);
    alert('✅ ' + sellerName + ' এর ' + count + ' টি UID ক্লিপবোর্ডে কপি করা হয়েছে!');
  }

  function downloadSellerUids(sellerName, uidsText) {
    if (!uidsText) return alert('কোনো UID পাওয়া যায়নি');
    var blob = new Blob([uidsText], { type: 'text/plain;charset=utf-8' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    var safeName = sellerName.replace(/[^a-zA-Z0-9_-]/g, '_');
    a.href = url;
    a.download = 'broken_uids_' + safeName + '.txt';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape') { closeViewer(); closeResolveModal(); closeRejectModal(); }
  });
</script>

