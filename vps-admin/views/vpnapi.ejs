<%- include('partials/header', { title: 'VPN Provider API', msg, currentPath }) %>

<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 flex items-center gap-2.5">
      <span>🔌 VPN Provider API</span>
      <span class="text-xs font-mono font-bold bg-sky-50 text-sky-700 border border-sky-200 px-2.5 py-0.5 rounded-full shadow-xs">
        BASICTRICK Automated Hub
      </span>
    </h1>
    <p class="text-xs text-slate-500 mt-1">
      Automated VPN provider connection (`vpn.sajeebtechonline.top`) — real-time order dispatch & delivery
    </p>
  </div>
  <div class="flex items-center gap-2">
    <form method="post" action="/vpnapi/sync" class="inline">
      <button class="bg-gradient-to-r from-sky-500 to-sky-600 hover:from-sky-600 hover:to-sky-700 text-white px-4 py-2 rounded-xl text-xs font-bold transition shadow-xs flex items-center gap-1.5">
        <span>🔄</span> Sync Packages
      </button>
    </form>
    <form method="post" action="/vpnapi/import" class="inline"
          onsubmit="return confirm('এগুলো আমাদের VPN Packages এ যোগ করবেন? (price 0 থাকবে, পরে /vpn এ বসাবেন)');">
      <button class="bg-emerald-50 border border-emerald-200 hover:bg-emerald-100 text-emerald-800 px-3.5 py-2 rounded-xl text-xs font-bold flex items-center gap-1.5 transition shadow-xs">
        <span>➕</span> Import to Store
      </button>
    </form>
  </div>
</div>

<!-- KPI Cards -->
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
  <!-- Provider Balance -->
  <div class="commercial-card p-5 rounded-2xl bg-white border border-sky-200 shadow-xs">
    <div class="text-[11px] font-extrabold text-slate-500 uppercase tracking-wider">💰 Provider Live Balance</div>
    <div class="flex items-baseline gap-2 mt-1.5">
      <% if (balance !== null) { %>
        <span class="text-2xl font-black text-slate-900"><%= balance %></span>
        <span class="text-xs font-bold px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200">Active</span>
      <% } else { %>
        <span class="text-lg font-bold text-rose-600"><%= balanceErr || 'API Error' %></span>
      <% } %>
    </div>
    <div class="text-[11px] text-slate-400 mt-1">Provider: vpn.sajeebtechonline.top</div>
  </div>

  <!-- Auto-Order Status -->
  <div class="commercial-card p-5 rounded-2xl bg-white border border-sky-200 shadow-xs">
    <div class="text-[11px] font-extrabold text-slate-500 uppercase tracking-wider">⚡ Auto-Order Dispatch</div>
    <div class="flex items-center justify-between mt-1.5">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full <%= autoOrder ? 'bg-emerald-500 animate-pulse' : 'bg-rose-500' %>"></span>
        <span class="text-base font-bold text-slate-900"><%= autoOrder ? 'ENABLED (স্বয়ংক্রিয়)' : 'DISABLED (ম্যানুয়াল)' %></span>
      </div>
      <form method="post" action="/vpnapi/toggle-auto" class="inline">
        <button class="text-xs font-bold px-3 py-1 rounded-lg border transition <%= autoOrder ? 'bg-rose-50 text-rose-700 border-rose-200 hover:bg-rose-100' : 'bg-emerald-50 text-emerald-700 border-emerald-200 hover:bg-emerald-100' %>">
          <%= autoOrder ? 'Turn OFF' : 'Turn ON' %>
        </button>
      </form>
    </div>
    <div class="text-[11px] text-slate-400 mt-1">ইউজার অর্ডার করলে বট সরাসরি API থেকে ডেলিভার করবে</div>
  </div>

  <!-- Last Sync Time -->
  <div class="commercial-card p-5 rounded-2xl bg-white border border-sky-200 shadow-xs">
    <div class="text-[11px] font-extrabold text-slate-500 uppercase tracking-wider">⏱️ Catalog Sync Status</div>
    <div class="text-lg font-bold text-slate-900 mt-1.5">
      <% if (lastSync) { %>
        <%= new Date(lastSync * 1000).toLocaleString('en-GB', { timeZone: 'Asia/Dhaka' }) %>
      <% } else { %>
        Never Synced
      <% } %>
    </div>
    <div class="text-[11px] text-slate-400 mt-1"><%= services.length %> active packages synced</div>
  </div>
</div>

<!-- API Settings Form Card -->
<div class="commercial-card rounded-2xl p-5 bg-white border border-sky-200 shadow-xs mb-6">
  <div class="flex items-center gap-2 mb-4 pb-3 border-b border-sky-100">
    <span class="text-lg">⚙️</span>
    <h2 class="text-sm font-bold text-slate-900">API Credentials & Endpoint Settings</h2>
  </div>
  <form method="post" action="/vpnapi/settings" class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end">
    <div class="md:col-span-6">
      <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
        API Endpoint URL
      </label>
      <input name="api_url" value="<%= apiUrl %>"
             class="w-full bg-slate-50 border border-slate-200 focus:border-sky-500 focus:bg-white rounded-xl px-3.5 py-2.5 text-xs font-mono text-slate-800 outline-none transition"/>
    </div>
    <div class="md:col-span-4">
      <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
        API Key <span class="text-[11px] text-slate-400 font-normal"><%= keySet ? '(Active: ' + keyMask + ')' : '(Not set)' %></span>
      </label>
      <input name="api_key" type="password" placeholder="<%= keySet ? 'Change API Key...' : 'TTECH_...' %>"
             class="w-full bg-slate-50 border border-slate-200 focus:border-sky-500 focus:bg-white rounded-xl px-3.5 py-2.5 text-xs font-mono text-slate-800 outline-none transition"/>
    </div>
    <div class="md:col-span-2">
      <button type="submit" class="w-full bg-gradient-to-r from-sky-500 to-sky-600 hover:from-sky-600 hover:to-sky-700 text-white font-bold py-2.5 rounded-xl text-xs transition shadow-xs">
        💾 Save Settings
      </button>
    </div>
  </form>
</div>

<!-- Services Table Container -->
<div class="commercial-card rounded-2xl overflow-hidden bg-white border border-sky-200 shadow-sm mb-6">
  <div class="flex items-center justify-between px-6 py-4 border-b border-sky-100 bg-sky-50/80">
    <div class="font-bold text-slate-900 text-sm flex items-center gap-2">
      <span>📦 Provider Services & Packages</span>
      <span class="text-xs font-mono bg-sky-100 text-sky-800 px-2.5 py-0.5 rounded-full"><%= services.length %></span>
    </div>
    <div class="text-xs text-slate-500">
      Selling prices are configured in <a href="/vpn" class="text-sky-600 font-bold hover:underline">💵 VPN Pricing</a>
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-xs">
      <thead>
        <tr class="border-b border-sky-100 bg-sky-50/90 text-sky-800 font-mono text-[11px] tracking-wider uppercase font-bold">
          <th class="py-3.5 px-4 text-left">Code</th>
          <th class="py-3.5 px-4 text-left">Brand / Name</th>
          <th class="py-3.5 px-4 text-left">Category / Duration</th>
          <th class="py-3.5 px-4 text-left">Store Mapping</th>
          <th class="py-3.5 px-4 text-left">Provider Cost</th>
          <th class="py-3.5 px-4 text-left">Order Limits</th>
          <th class="py-3.5 px-4 text-right">Provider Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-sky-100">
        <% if (!services.length) { %>
          <tr>
            <td colspan="7" class="text-center text-slate-400 py-12">
              <div class="text-3xl mb-2">📭</div>
              <div class="font-medium">কোনো সার্ভিস ডাটা নেই — উপরে "Sync Packages" চাপুন।</div>
            </td>
          </tr>
        <% } %>
        <% services.forEach(function(s){ %>
          <tr class="hover:bg-sky-50/50 transition <%= s.available ? '' : 'opacity-60 bg-slate-50/50' %>">
            <td class="py-3.5 px-4 font-mono font-bold text-sky-700">
              <span class="bg-sky-50 border border-sky-200 px-2 py-0.5 rounded-md">#<%= s.service %></span>
            </td>
            <td class="py-3.5 px-4 font-bold text-slate-900">
              <%= s.name %>
            </td>
            <td class="py-3.5 px-4 text-slate-700 font-medium">
              <%= s.category || '—' %>
              <% if (s.days != null) { %>
                <span class="text-[11px] font-mono text-slate-500 block"><%= s.days %> Days</span>
              <% } %>
            </td>
            <td class="py-3.5 px-4 font-mono font-bold text-sky-600">
              <span class="bg-slate-100 border border-slate-200 px-2 py-0.5 rounded-md text-[11px]">
                <%= s.vpn_id %> / <%= s.pkg_id || '—' %>
              </span>
            </td>
            <td class="py-3.5 px-4 text-slate-900 font-bold">
              <%= s.rate %>৳
              <% if (s.discount_percent) { %>
                <span class="text-[11px] text-slate-400 line-through ml-1"><%= s.original_rate %>৳</span>
                <span class="text-[10px] font-bold text-emerald-600 bg-emerald-50 border border-emerald-200 px-1 rounded ml-1">-<%= s.discount_percent %>%</span>
              <% } %>
            </td>
            <td class="py-3.5 px-4 font-mono text-slate-500">
              <%= s.min_qty %> – <%= s.max_qty %> pcs
            </td>
            <td class="py-3.5 px-4 text-right">
              <% if (s.available) { %>
                <span class="inline-flex items-center gap-1 text-[11px] font-bold px-2.5 py-1 rounded-lg bg-emerald-50 text-emerald-700 border border-emerald-200 shadow-xs">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Available
                </span>
              <% } else { %>
                <span class="inline-flex items-center gap-1 text-[11px] font-bold px-2.5 py-1 rounded-lg bg-rose-50 text-rose-700 border border-rose-200 shadow-xs">
                  <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span> Stock Out
                </span>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="text-xs text-slate-500 flex items-center gap-1.5 px-2">
  <span>💡</span>
  <span><b>Provider Cost</b> হলো প্রোভাইডারের কেনা দাম। আমাদের বিক্রয়মূল্য নির্ধারণ করতে <a href="/vpn" class="text-sky-600 font-bold hover:underline">VPN Prices</a> পেজ ব্যবহার করুন।</span>
</div>

<%- include('partials/footer') %>
