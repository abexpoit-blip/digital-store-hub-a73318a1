<%- include('partials/header', { title: 'Send Notice', msg, currentPath }) %>

<h1 class="text-2xl font-bold mb-2">📢 Send Notice</h1>
<p class="text-sm text-slate-400 mb-6">সব user বা একজন নির্দিষ্ট user কে Telegram এ message পাঠান।</p>

<% if (!botTokenSet) { %>
  <div class="bg-rose-900/40 border border-rose-700 text-rose-200 p-4 rounded-xl mb-6 text-sm">
    ⚠️ <b>BOT_TOKEN missing!</b> <code>vps-admin/.env</code> এ যোগ করুন:
    <pre class="mt-2 bg-slate-950 p-2 rounded text-xs">BOT_TOKEN=8364765061:AAEoT6w2l74JDowWUns2EC5OT8wEcIji9Y4</pre>
    তারপর <code>pm2 restart nexusx-admin --update-env</code>
  </div>
<% } %>

<form method="post" action="/notice/send" enctype="multipart/form-data" class="bg-slate-900 border border-slate-800 p-6 rounded-2xl space-y-5 max-w-2xl shadow-xl">
  <div>
    <label class="text-sm font-semibold block mb-2 text-slate-200">কাকে পাঠাবেন?</label>
    <div class="flex flex-wrap gap-4 items-center">
      <label class="flex items-center gap-2 text-sm text-slate-300 cursor-pointer">
        <input type="radio" name="target" value="all" checked onchange="document.getElementById('uid').disabled=true" class="accent-cyan-500">
        🌍 সব active user (<%= totalUsers %> জন)
      </label>
      <label class="flex items-center gap-2 text-sm text-slate-300 cursor-pointer">
        <input type="radio" name="target" value="single" onchange="document.getElementById('uid').disabled=false" class="accent-cyan-500">
        👤 একজন
      </label>
      <input id="uid" name="single_id" disabled placeholder="user_id"
             class="bg-slate-800 border border-slate-700 rounded-xl px-3 py-1.5 text-sm font-mono w-40 text-slate-200 outline-none focus:border-cyan-500"/>
    </div>
  </div>

  <!-- Photo / Image Upload Section -->
  <div class="bg-slate-950/60 border border-slate-800 p-4 rounded-xl space-y-3">
    <label class="text-sm font-semibold block text-slate-200 flex items-center gap-2">
      <span>🖼️</span> নোটিশে ছবি সংযুক্ত করুন (ঐচ্ছিক):
    </label>
    <div>
      <input type="file" name="photo" id="photoInput" accept="image/*" onchange="previewImage(event)"
             class="w-full text-xs text-slate-400 file:mr-3 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-bold file:bg-cyan-900/40 file:text-cyan-300 hover:file:bg-cyan-800/50 file:cursor-pointer border border-dashed border-slate-700 rounded-xl p-2.5 bg-slate-900"/>
    </div>

    <!-- Image Preview Box -->
    <div id="imagePreviewContainer" class="hidden relative inline-block">
      <div class="relative w-48 h-32 rounded-xl overflow-hidden border border-slate-700 bg-slate-900 shadow-md">
        <img id="imagePreview" src="" alt="Notice Preview" class="w-full h-full object-cover">
        <button type="button" onclick="removeImage()"
                class="absolute top-1.5 right-1.5 bg-rose-600 hover:bg-rose-500 text-white rounded-full w-6 h-6 flex items-center justify-center text-xs font-bold shadow-md transition"
                title="Remove photo">✕</button>
      </div>
    </div>

    <div class="relative flex items-center justify-center my-1">
      <div class="border-t border-slate-800 w-full"></div>
      <div class="bg-slate-900 px-2 text-[11px] text-slate-500 uppercase tracking-wider absolute font-semibold">অথবা ইমেজ URL</div>
    </div>

    <div>
      <input type="url" name="image_url" id="imageUrlInput" placeholder="https://example.com/banner.jpg"
             class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-xs text-slate-200 placeholder-slate-500 outline-none focus:border-cyan-500"/>
      <p class="text-[11px] text-slate-500 mt-1">💡 সরাসরি ডিভাইস থেকে ছবি আপলোড করতে পারেন অথবা অনলাইন ছবির ডিরেক্ট লিংক দিতে পারেন।</p>
    </div>
  </div>

  <div>
    <label class="text-sm font-semibold block mb-2 text-slate-200">
      Message / Caption (HTML allowed: &lt;b&gt; &lt;i&gt; &lt;a href&gt; &lt;code&gt;)
    </label>
    <textarea name="text" id="noticeText" rows="6" placeholder="🎉 নতুন stock এসেছে! এখনই কিনুন..."
      class="w-full bg-slate-800 border border-slate-700 rounded-xl px-3 py-2.5 text-sm font-mono text-slate-200 placeholder-slate-500 outline-none focus:border-cyan-500"></textarea>
    <p class="text-[11px] text-slate-500 mt-1">📌 ছবির সাথে ক্যাপশন সর্বোচ্চ ১০২৪ ক্যারেক্টার হতে পারে। এর বেশি বড় মেসেজ হলে ছবিটি ও মেসেজটি দুটি আলাদা বার্তায় স্বয়ংক্রিয়ভাবে চলে যাবে।</p>
  </div>

  <div class="flex gap-3 pt-2">
    <button type="submit" class="bg-cyan-600 hover:bg-cyan-500 px-6 py-2.5 rounded-xl text-sm font-bold text-white flex items-center gap-2 shadow-lg shadow-cyan-600/20 transition">
      <span>📢</span> Send Notice
    </button>
    <a href="/" class="px-4 py-2.5 text-sm text-slate-400 hover:text-white rounded-xl transition">Cancel</a>
  </div>
</form>

<script>
function previewImage(event) {
  const file = event.target.files[0];
  const container = document.getElementById('imagePreviewContainer');
  const preview = document.getElementById('imagePreview');
  if (file) {
    preview.src = URL.createObjectURL(file);
    container.classList.remove('hidden');
  } else {
    removeImage();
  }
}

function removeImage() {
  const input = document.getElementById('photoInput');
  const container = document.getElementById('imagePreviewContainer');
  const preview = document.getElementById('imagePreview');
  input.value = '';
  preview.src = '';
  container.classList.add('hidden');
}

// When "single" selected, copy uid into hidden target on submit
document.querySelector('form').addEventListener('submit', function(e){
  const radios = document.querySelectorAll('input[name="target"]');
  const sel = Array.from(radios).find(r => r.checked).value;
  if (sel === 'single') {
    const uid = document.getElementById('uid').value.trim();
    if (!uid) { e.preventDefault(); alert('user_id দিন'); return; }
    Array.from(radios).find(r => r.value === 'single').value = uid;
  }

  const textVal = document.getElementById('noticeText').value.trim();
  const fileVal = document.getElementById('photoInput').value;
  const urlVal = document.getElementById('imageUrlInput').value.trim();
  if (!textVal && !fileVal && !urlVal) {
    e.preventDefault();
    alert('অনুগ্রহ করে নোটিশের মেসেজ অথবা ছবি প্রদান করুন!');
    return;
  }
});
</script>

<%- include('partials/footer') %>
