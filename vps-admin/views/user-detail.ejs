<%- include('partials/header', { title: 'User Detail', msg, currentPath }) %>

<a href="/users" class="text-sm text-slate-400 hover:text-white">← Back to users</a>

<div class="flex items-center justify-between mt-3 mb-6">
  <div>
    <h1 class="text-2xl font-bold"><%= user.username || 'Unknown' %></h1>
    <div class="text-sm text-slate-400 font-mono">ID: <%= user.user_id %></div>
  </div>
  <div class="text-right">
    <div class="text-3xl font-bold text-emerald-400"><%= (user.balance||0).toLocaleString() %>৳</div>
    <div class="text-xs text-slate-500">Current balance</div>
  </div>
</div>

<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
  <div class="bg-slate-900 border border-slate-800 p-4 rounded-xl">
    <div class="text-xs text-slate-400">Total Spent</div>
    <div class="text-xl font-bold mt-1"><%= totalSpent.toLocaleString() %>৳</div>
  </div>
  <div class="bg-slate-900 border border-slate-800 p-4 rounded-xl">
    <div class="text-xs text-slate-400">Total Deposited</div>
    <div class="text-xl font-bold mt-1 text-cyan-400"><%= totalDeposited.toLocaleString() %>৳</div>
  </div>
  <div class="bg-slate-900 border border-slate-800 p-4 rounded-xl">
    <div class="text-xs text-slate-400">Orders</div>
    <div class="text-xl font-bold mt-1"><%= sales.length %></div>
  </div>
  <div class="bg-slate-900 border border-slate-800 p-4 rounded-xl">
    <div class="text-xs text-slate-400">Status</div>
    <div class="text-xl font-bold mt-1 <%= user.is_banned ? 'text-rose-400' : 'text-emerald-400' %>">
      <%= user.is_banned ? 'BANNED' : 'Active' %>
    </div>
    <% if (user.is_banned && user.ban_reason) { %>
      <div class="text-[11px] text-rose-300/80 mt-1 truncate" title="<%= user.ban_reason %>">
        কারণ: <%= user.ban_reason %>
      </div>
    <% } %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
  <form method="post" action="/users/<%= user.user_id %>/balance"
        class="bg-slate-900 border border-slate-800 p-5 rounded-xl">
    <div class="text-sm font-semibold mb-3">💰 Adjust Balance</div>
    <div class="grid grid-cols-2 gap-3 mb-3">
      <input type="number" name="delta" step="1" placeholder="Amount (e.g. +50 or -50)" required
             class="bg-slate-800 border border-slate-700 text-white rounded px-3 py-2 text-sm"/>
      <input type="text" name="reason" placeholder="Reason (audit log এ যাবে)" required
             class="bg-slate-800 border border-slate-700 text-white rounded px-3 py-2 text-sm"/>
    </div>
    <button class="w-full bg-cyan-600 hover:bg-cyan-500 py-2 rounded text-sm font-semibold">Apply</button>
    <p class="text-xs text-slate-500 mt-2">Positive = add, negative = deduct</p>
  </form>

  <% if (user.is_banned) { %>
    <div class="bg-slate-900 border border-rose-900/60 p-5 rounded-xl">
      <div class="text-sm font-semibold mb-2 text-rose-400 flex items-center justify-between">
        <span>🚫 Banned User</span>
        <span class="bg-rose-900/60 text-rose-200 text-xs px-2 py-0.5 rounded border border-rose-700 font-bold">BANNED</span>
      </div>
      <div class="bg-rose-950/40 border border-rose-800/40 p-3 rounded-lg text-xs mb-4">
        <span class="text-slate-400 block mb-1 font-medium">⚠️ ব্যান করার কারণ (User sees this in bot):</span>
        <span class="text-rose-200 font-bold text-sm"><%= user.ban_reason || 'নির্দিষ্ট কারণ উল্লেখ নেই' %></span>
      </div>
      <form method="post" action="/users/<%= user.user_id %>/ban">
        <input type="hidden" name="banned" value="0"/>
        <p class="text-xs text-slate-400 mb-3">আনব্যান করলে এই ইউজার আবার স্বাভাবিকভাবে বট ব্যবহার করতে পারবে।</p>
        <button class="w-full bg-emerald-600 hover:bg-emerald-500 py-2 rounded text-sm font-semibold text-white transition">
          ✅ Unban User
        </button>
      </form>
    </div>
  <% } else { %>
    <form method="post" action="/users/<%= user.user_id %>/ban"
          class="bg-slate-900 border border-slate-800 p-5 rounded-xl">
      <div class="text-sm font-semibold mb-3 text-rose-400">🚫 Ban User</div>
      <input type="hidden" name="banned" value="1"/>
      <div class="mb-3">
        <label class="block text-xs font-semibold text-slate-300 mb-1">
          ব্যান করার কারণ <span class="text-rose-400">*</span> (ইউজার বটে দেখতে পাবে):
        </label>
        <input type="text" name="ban_reason" placeholder="e.g. ফেক রিপ্লেস সাবমিশন / প্রতারণা" required
               class="w-full bg-slate-800 border border-slate-700 text-white rounded px-3 py-2 text-sm focus:outline-none focus:border-rose-500"/>
        <p class="text-[11px] text-slate-400 mt-1">এই ইউজার বটে ঢুকলে এই কারণ দেখতে পাবে এবং কমপ্লেইন বক্স সহ কোনো অ্যাক্সেস পাবে না।</p>
      </div>
      <button class="w-full bg-rose-600 hover:bg-rose-500 py-2 rounded text-sm font-semibold text-white transition">
        🚫 Confirm Ban
      </button>
    </form>
  <% } %>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">
    <div class="px-4 py-3 border-b border-slate-800 text-sm font-semibold">💸 Deposit History</div>
    <table class="w-full text-xs">
      <thead><tr><th>Amount</th><th>Status</th><th>Date</th></tr></thead>
      <tbody>
        <% if (!deposits.length) { %><tr><td colspan="3" class="text-center text-slate-500 py-4">No deposits</td></tr><% } %>
        <% deposits.forEach(function(d){ %>
          <tr>
            <td><%= d.amount %>৳</td>
            <td>
              <span class="px-2 py-0.5 rounded text-xs
                <%= d.status==='approved'?'bg-emerald-700/40 text-emerald-300':d.status==='pending'?'bg-amber-700/40 text-amber-300':'bg-rose-700/40 text-rose-300' %>">
                <%= d.status %>
              </span>
            </td>
            <td class="text-slate-400"><%= d.date || '-' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">
    <div class="px-4 py-3 border-b border-slate-800 text-sm font-semibold flex justify-between items-center">
      <span>📥 Purchase History (delivered IDs সহ)</span>
      <span class="text-xs text-slate-500"><%= sales.length %> orders</span>
    </div>
    <div class="max-h-[500px] overflow-y-auto">
      <% if (!sales.length) { %><div class="text-center text-slate-500 py-6 text-sm">No orders</div><% } %>
      <% sales.forEach(function(s){ %>
        <% var delivered = deliveredBySale[s.id] || []; %>
        <details class="border-b border-slate-800">
          <summary class="px-4 py-2 cursor-pointer hover:bg-slate-800/50 text-xs flex justify-between items-center">
            <div>
              <span class="text-cyan-400 font-semibold"><%= s.category %></span>
              <span class="text-slate-300 mx-2">× <%= s.qty %></span>
              <span class="text-emerald-400"><%= s.total %>৳</span>
            </div>
            <div class="text-slate-500">
              <%= s.date %> <%= s.time || '' %>
              <% if (delivered.length) { %>
                <span class="ml-2 bg-emerald-900/40 text-emerald-300 px-1.5 py-0.5 rounded">
                  📦 <%= delivered.length %> archived
                </span>
              <% } else { %>
                <span class="ml-2 text-slate-600">no archive</span>
              <% } %>
            </div>
          </summary>
          <div class="bg-slate-950 px-3 py-2 text-[11px] font-mono flex items-center gap-2">
            <span class="text-slate-500">🔗 Buyer download link:</span>
            <input readonly value="<%= s._download %>" onclick="this.select()"
                   class="flex-1 bg-slate-900 border border-slate-800 rounded px-2 py-1 text-cyan-300"/>
            <a href="<%= s._download %>" target="_blank" class="bg-cyan-700 hover:bg-cyan-600 px-2 py-1 rounded text-white">Open</a>
          </div>
          <% if (delivered.length) { %>
            <div class="bg-slate-950 px-3 py-2">
              <table class="w-full text-xs font-mono">
                <thead><tr class="text-slate-500 text-left"><th class="py-1">#</th><th>Stock ID</th><th>Source</th><th>Data (UID PASS COOKIES)</th></tr></thead>
                <tbody>
                  <% delivered.forEach(function(d, i){ %>
                    <tr class="border-t border-slate-800/60">
                      <td class="text-slate-600 py-1"><%= i+1 %></td>
                      <td class="text-amber-400">#<%= d.stock_id || '-' %></td>
                      <td class="text-cyan-500"><%= d.source %></td>
                      <td class="text-slate-300 break-all"><%= (d.data||'').slice(0,160) %><%= (d.data||'').length>160?'...':'' %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } else { %>
            <div class="bg-slate-950 px-4 py-2 text-xs text-slate-500">
              ⚠️ এই order এর delivered IDs archive এ নেই (পুরোনো order — archive feature এর আগে delivered)।
            </div>
          <% } %>
        </details>
      <% }) %>
    </div>
  </div>
</div>

<% if (unlinkedDeliveries.length) { %>
  <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden mt-6">
    <div class="px-4 py-3 border-b border-slate-800 text-sm font-semibold">
      📦 Unlinked Deliveries (<%= unlinkedDeliveries.length %>)
      <span class="text-xs text-slate-500 ml-2">— archive আছে কিন্তু sale row match নাই</span>
    </div>
    <div class="max-h-64 overflow-y-auto">
      <table class="w-full text-xs font-mono">
        <thead><tr><th>Cat</th><th>Stock#</th><th>Source</th><th>Data</th></tr></thead>
        <tbody>
          <% unlinkedDeliveries.forEach(function(d){ %>
            <tr><td class="text-cyan-400"><%= d.category %></td><td class="text-amber-400">#<%= d.stock_id||'-' %></td><td><%= d.source %></td><td class="text-slate-300 break-all"><%= (d.data||'').slice(0,140) %></td></tr>
          <% }) %></tbody>
      </table>
    </div>
  </div>
<% } %>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-8">
  <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">
    <div class="px-4 py-3 border-b border-slate-800 text-sm font-semibold flex items-center justify-between">
      <span>🎁 Manual Balance (Admin)</span>
      <span class="text-xs <%= manualTotal >= 0 ? 'text-emerald-400' : 'text-rose-400' %>">
        Net: <%= manualTotal > 0 ? '+' : '' %><%= manualTotal %>৳ · <%= manualCredits.length %> time(s)
      </span>
    </div>
    <% if (manualCredits.length >= 3) { %>
      <div class="px-4 py-2 bg-amber-950/40 text-amber-300 text-xs">⚠️ এই user <%= manualCredits.length %> বার manual balance পেয়েছে/নিয়েছে।</div>
    <% } %>
    <table class="w-full text-sm">
      <thead class="text-slate-400"><tr>
        <th class="text-left px-4 py-2">Amount</th><th class="text-left px-4 py-2">After</th>
        <th class="text-left px-4 py-2">Reason</th><th class="text-left px-4 py-2">Time</th>
      </tr></thead>
      <tbody>
        <% if (!manualCredits.length) { %><tr><td colspan="4" class="text-center text-slate-500 py-6">কোনো manual balance দেওয়া হয়নি।</td></tr><% } %>
        <% manualCredits.forEach(function(m){ %>
          <tr class="border-t border-slate-800">
            <td class="px-4 py-2 font-bold <%= m.delta > 0 ? 'text-emerald-400' : 'text-rose-400' %>"><%= m.delta > 0 ? '+' : '' %><%= m.delta %>৳</td>
            <td class="px-4 py-2 text-slate-300"><%= m.balance_after == null ? '-' : m.balance_after + '৳' %></td>
            <td class="px-4 py-2 text-xs text-slate-300"><%= m.reason || '-' %></td>
            <td class="px-4 py-2 text-xs text-slate-400"><%= m._date %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">
    <div class="px-4 py-3 border-b border-slate-800 text-sm font-semibold flex items-center justify-between">
      <span>🔄 Replace History</span>
      <span class="text-xs text-slate-400">
        Total <%= replaceStats.total %> · ⏳<%= replaceStats.pending %> · ✅<%= replaceStats.collected %> · ❌<%= replaceStats.rejected %>
      </span>
    </div>
    <% if (replaceStats.total >= 3) { %>
      <div class="px-4 py-2 bg-amber-950/40 text-amber-300 text-xs">⚠️ এই user <%= replaceStats.total %> বার replace চেয়েছে।</div>
    <% } %>
    <table class="w-full text-sm">
      <thead class="text-slate-400"><tr>
        <th class="text-left px-4 py-2">#</th><th class="text-left px-4 py-2">Category</th>
        <th class="text-left px-4 py-2">Status</th><th class="text-left px-4 py-2">Time</th>
      </tr></thead>
      <tbody>
        <% if (!replaceHistory.length) { %><tr><td colspan="4" class="text-center text-slate-500 py-6">কোনো replace request নেই।</td></tr><% } %>
        <% replaceHistory.forEach(function(r){ var st=(r.status||'pending').toLowerCase(); %>
          <tr class="border-t border-slate-800">
            <td class="px-4 py-2 font-mono text-slate-500">#<%= r.id %></td>
            <td class="px-4 py-2"><%= r.category || '-' %></td>
            <td class="px-4 py-2 text-xs <%= st === 'collected' ? 'text-emerald-400' : (st === 'rejected' ? 'text-rose-400' : 'text-amber-400') %>"><%= st %></td>
            <td class="px-4 py-2 text-xs text-slate-400"><%= r._date %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>


<form method="post" action="/users/<%= user.user_id %>/delete"
      onsubmit="return confirm('⚠️ এই user এবং তার সব sales/deposits/archive permanently মুছে যাবে। নিশ্চিত?');"
      class="bg-rose-950/30 border border-rose-900 p-5 rounded-xl mt-8">
  <div class="text-sm font-semibold text-rose-300 mb-2">🗑️ Delete User Permanently</div>
  <p class="text-xs text-slate-400 mb-3">User এবং তার সব data (sales, deposits, delivery archive, replace requests) মুছে যাবে। Confirm এ user_id (<code><%= user.user_id %></code>) লিখুন।</p>
  <div class="flex gap-2">
    <input name="confirm" placeholder="<%= user.user_id %>" required
           class="bg-slate-800 border border-slate-700 rounded px-3 py-2 text-sm font-mono w-48"/>
    <button class="bg-rose-700 hover:bg-rose-600 px-4 py-2 rounded text-sm font-semibold text-white">Delete Forever</button>
  </div>
</form>

<%- include('partials/footer') %>
