<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title><%= typeof title !== 'undefined' ? title : 'Basictrick Admin' %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<style>
  body {
    font-family: 'Plus Jakarta Sans', ui-sans-serif, system-ui, sans-serif;
    background-color: #030712;
    background-image: 
      radial-gradient(at 0% 0%, rgba(14, 165, 233, 0.08) 0px, transparent 50%),
      radial-gradient(at 100% 100%, rgba(99, 102, 241, 0.08) 0px, transparent 50%);
    background-attachment: fixed;
  }
  .font-mono { font-family: 'JetBrains Mono', monospace; }
  .nav-link.active {
    background: linear-gradient(135deg, rgba(6, 182, 212, 0.2) 0%, rgba(59, 130, 246, 0.15) 100%);
    color: #38bdf8;
    border-left: 3px solid #38bdf8;
    font-weight: 600;
  }
  table { border-collapse: collapse; }
  th, td { padding: 0.75rem 1rem; text-align: left; }
  th { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; color: #94a3b8; background: rgba(15, 23, 42, 0.8); }
  tr { border-bottom: 1px solid rgba(30, 41, 59, 0.6); }
  tr:hover { background: rgba(30, 41, 59, 0.35); }
  /* Custom scrollbar */
  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-track { background: #030712; }
  ::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 4px; }
  ::-webkit-scrollbar-thumb:hover { background: #334155; }
</style>
</head>
<body class="text-slate-100 min-h-screen antialiased selection:bg-cyan-500 selection:text-white">
<div class="flex min-h-screen">
  <aside class="w-64 bg-slate-950/80 backdrop-blur-xl border-r border-slate-800/80 flex flex-col shrink-0">
    <div class="px-6 py-5 border-b border-slate-800/80 flex items-center gap-3">
      <div class="h-9 w-9 rounded-xl bg-gradient-to-tr from-cyan-500 to-indigo-500 flex items-center justify-center font-black text-white shadow-lg shadow-cyan-500/20">
        B
      </div>
      <div>
        <div class="text-white font-extrabold text-sm tracking-wide flex items-center gap-1.5">
          <span>BASICTRICK</span>
          <span class="text-[9px] bg-cyan-500/20 text-cyan-300 font-mono px-1.5 py-0.2 rounded font-bold">PRO</span>
        </div>
        <div class="text-[11px] text-slate-400 font-medium">Digital Store Hub</div>
      </div>
    </div>
    <nav class="flex-1 p-3 space-y-1 text-xs font-medium overflow-y-auto">
      <% const _links = [
        ['/', '📊 Dashboard'],
        ['/users', '👥 Users'],
        ['/deposits', '💰 Deposits'],
        ['/stock', '📦 Stock Inventory'],
        ['/stock/check-uid', '🔍 Check UID'],
        ['/replace', '🔄 Replace Requests'],
        ['/orders', '📥 Orders History'],
        ['/nord', '🛡 Nord Accounts'],
        ['/vpn', '💵 VPN Pricing'],
        ['/vpnapi', '🔌 VPN Reseller API'],
        ['/buylimit', '⏱ Buy Limit Guard'],
        ['/polls', '📊 Telegram Polls'],
        ['/notice', '📢 Broadcast Notice'],
        ['/credits', '🎁 Manual Credits'],
        ['/audit', '📜 Audit Trail'],
        ['/maintenance', '🛠 Maintenance Mode'],
        ['/status', '⚙️ Server Status'],
      ]; %>
      <% _links.forEach(function(l){ var href=l[0], label=l[1];
         var active = (currentPath === href) || (href !== '/' && currentPath.startsWith(href)); %>
        <a href="<%= href %>"
           class="nav-link flex items-center px-3.5 py-2.5 rounded-xl text-slate-300 hover:bg-slate-800/60 hover:text-white transition group <%= active ? 'active' : '' %>">
          <span><%= label %></span>
        </a>
      <% }) %>
    </nav>
    <form method="post" action="/logout" class="p-4 border-t border-slate-800/80">
      <button class="w-full text-left px-3.5 py-2 rounded-xl text-rose-400/90 hover:text-rose-300 hover:bg-rose-500/10 text-xs font-semibold transition flex items-center justify-between">
        <span>↪ Logout Session</span>
      </button>
    </form>
  </aside>
  <main class="flex-1 overflow-x-auto">
    <% if (typeof msg !== 'undefined' && msg) { %>
      <div class="bg-gradient-to-r from-cyan-950/80 to-slate-950/80 border-b border-cyan-500/30 text-cyan-200 px-8 py-3 text-xs font-semibold flex items-center gap-2 backdrop-blur-md">
        <span class="h-2 w-2 rounded-full bg-cyan-400 animate-pulse"></span>
        <span><%= msg %></span>
      </div>
    <% } %>
    <div class="p-8 max-w-7xl mx-auto">
