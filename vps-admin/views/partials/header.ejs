<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title><%= typeof title !== 'undefined' ? title : 'Basictrick Enterprise' %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    theme: {
      extend: {
        colors: {
          sky: {
            50: '#f0f9ff',
            100: '#e0f2fe',
            200: '#bae6fd',
            300: '#7dd3fc',
            400: '#38bdf8',
            500: '#0ea5e9',
            600: '#0284c7',
            700: '#0369a1',
            800: '#075985',
            900: '#0c4a6e',
            950: '#082f49',
          }
        }
      }
    }
  }
</script>
<style>
  :root {
    --sky-primary: #0ea5e9;
    --sky-glow: rgba(14, 165, 233, 0.25);
    --sky-subtle: rgba(14, 165, 233, 0.08);
  }
  body {
    font-family: 'Plus Jakarta Sans', ui-sans-serif, system-ui, sans-serif;
    background-color: #f0f7ff;
    background-image: 
      radial-gradient(at 0% 0%, rgba(14, 165, 233, 0.12) 0px, transparent 45%),
      radial-gradient(at 100% 0%, rgba(56, 189, 248, 0.12) 0px, transparent 40%),
      radial-gradient(at 50% 100%, rgba(186, 230, 253, 0.35) 0px, transparent 60%),
      linear-gradient(to right, rgba(14, 165, 233, 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(14, 165, 233, 0.03) 1px, transparent 1px);
    background-size: 100% 100%, 100% 100%, 100% 100%, 32px 32px, 32px 32px;
    background-attachment: fixed;
    color: #1e293b;
  }
  .font-mono { font-family: 'JetBrains Mono', monospace; }
  
  /* Sky Blue Light Mode Active State */
  .nav-link.active {
    background: linear-gradient(90deg, #e0f2fe 0%, #f0f9ff 100%);
    color: #0284c7;
    border-left: 3.5px solid #0284c7;
    box-shadow: 0 2px 8px rgba(14, 165, 233, 0.12);
    font-weight: 700;
  }
  .nav-link.active svg, .nav-link.active span:first-child {
    filter: drop-shadow(0 0 6px rgba(14, 165, 233, 0.4));
  }
  
  /* Glass card commercial styling in Light Sky-Blue */
  .commercial-card {
    background: #ffffff;
    border: 1px solid #bae6fd;
    box-shadow: 0 4px 20px -2px rgba(14, 165, 233, 0.08), 0 2px 6px -1px rgba(0, 0, 0, 0.03);
    transition: all 0.2s ease-in-out;
  }
  .commercial-card:hover {
    border-color: #38bdf8;
    box-shadow: 0 8px 28px -4px rgba(14, 165, 233, 0.16);
  }

  table { border-collapse: collapse; }
  th, td { padding: 0.85rem 1rem; text-align: left; }
  th { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; color: #0369a1; background: #f0f9ff; font-weight: 700; }
  tr { border-bottom: 1px solid #e0f2fe; }
  tr:hover { background: #f8fbfe; }

  /* Sky custom scrollbar */
  ::-webkit-scrollbar { width: 7px; height: 7px; }
  ::-webkit-scrollbar-track { background: #f0f7ff; }
  ::-webkit-scrollbar-thumb { background: #7dd3fc; border-radius: 4px; }
  ::-webkit-scrollbar-thumb:hover { background: #0ea5e9; }
  
  /* Collapsed sidebar styles */
  body.sidebar-collapsed aside { width: 5.2rem; }
  body.sidebar-collapsed .brand-text,
  body.sidebar-collapsed .nav-text,
  body.sidebar-collapsed .nav-section-title,
  body.sidebar-collapsed .logout-text,
  body.sidebar-collapsed .sidebar-footer { display: none; }
  body.sidebar-collapsed .nav-link { justify-content: center; padding-left: 0.5rem; padding-right: 0.5rem; }
</style>
</head>
<body class="text-slate-800 min-h-screen antialiased selection:bg-sky-500 selection:text-white flex flex-col">
<div class="flex flex-1 min-h-screen overflow-hidden">
  <!-- Crisp Light Sky-Blue Sidebar -->
  <aside id="main-sidebar" class="w-64 bg-white/95 backdrop-blur-2xl border-r border-sky-200/80 flex flex-col shrink-0 transition-all duration-300 z-30 shadow-xl shadow-sky-100/60">
    <!-- Brand Header -->
    <div class="px-5 py-4 border-b border-sky-100 flex items-center justify-between bg-sky-50/60">
      <div class="flex items-center gap-3">
        <div class="h-10 w-10 rounded-xl bg-gradient-to-tr from-sky-600 via-sky-500 to-cyan-400 flex items-center justify-center font-black text-white shadow-md shadow-sky-500/30 shrink-0">
          <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
          </svg>
        </div>
        <div class="brand-text">
          <div class="text-slate-900 font-extrabold text-sm tracking-wide flex items-center gap-1.5">
            <span class="bg-gradient-to-r from-sky-600 to-blue-700 bg-clip-text text-transparent">BASICTRICK</span>
            <span class="text-[9px] bg-sky-100 text-sky-700 border border-sky-300 font-mono px-1.5 py-0.2 rounded font-bold shadow-xs">PRO</span>
          </div>
          <div class="text-[11px] text-sky-600 font-bold tracking-wider uppercase">Enterprise Cloud</div>
        </div>
      </div>
      <button onclick="toggleSidebar()" title="Toggle Sidebar" class="p-1.5 text-sky-600 hover:text-sky-800 hover:bg-sky-100/80 rounded-lg transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>
    </div>

    <!-- Grouped Modern Navigation -->
    <nav class="flex-1 p-3 space-y-3 text-xs font-medium overflow-y-auto">
      <!-- Group 1: Core Operations -->
      <div>
        <div class="nav-section-title px-3 py-1 text-[10px] font-mono uppercase tracking-widest text-sky-700 font-extrabold">⚡ Core Operations</div>
        <div class="space-y-0.5 mt-1">
          <% const group1 = [
            ['/', '📊 Dashboard'],
            ['/orders', '📥 Orders History'],
            ['/replace', '🔄 Replace Requests'],
            ['/users', '👥 User Registry'],
          ]; %>
          <% group1.forEach(function(l){ var href=l[0], label=l[1];
             var active = (currentPath === href) || (href !== '/' && currentPath.startsWith(href)); %>
            <a href="<%= href %>" class="nav-link flex items-center px-3 py-2 rounded-xl text-slate-700 hover:bg-sky-50 hover:text-sky-700 transition group <%= active ? 'active' : '' %>">
              <span class="nav-text truncate"><%= label %></span>
            </a>
          <% }) %>
        </div>
      </div>

      <!-- Group 2: Inventory & Catalog -->
      <div>
        <div class="nav-section-title px-3 py-1 text-[10px] font-mono uppercase tracking-widest text-sky-700 font-extrabold">📦 Stock & Services</div>
        <div class="space-y-0.5 mt-1">
          <% const group2 = [
            ['/stock', '📦 Stock Inventory'],
            ['/stock/check-uid', '🔍 Check UID'],
            ['/nord', '🛡 Nord Accounts'],
            ['/vpn', '💵 VPN Pricing'],
            ['/vpnapi', '🔌 VPN Reseller API'],
          ]; %>
          <% group2.forEach(function(l){ var href=l[0], label=l[1];
             var active = (currentPath === href) || (href !== '/' && currentPath.startsWith(href)); %>
            <a href="<%= href %>" class="nav-link flex items-center px-3 py-2 rounded-xl text-slate-700 hover:bg-sky-50 hover:text-sky-700 transition group <%= active ? 'active' : '' %>">
              <span class="nav-text truncate"><%= label %></span>
            </a>
          <% }) %>
        </div>
      </div>

      <!-- Group 3: Finance & Billing -->
      <div>
        <div class="nav-section-title px-3 py-1 text-[10px] font-mono uppercase tracking-widest text-sky-700 font-extrabold">💳 Finance & Growth</div>
        <div class="space-y-0.5 mt-1">
          <% const group3 = [
            ['/deposits', '💰 Deposits & ZiniPay'],
            ['/credits', '🎁 Manual Credits'],
            ['/buylimit', '⏱ Buy Limit Guard'],
            ['/polls', '📊 Telegram Polls'],
            ['/notice', '📢 Broadcast Notice'],
          ]; %>
          <% group3.forEach(function(l){ var href=l[0], label=l[1];
             var active = (currentPath === href) || (href !== '/' && currentPath.startsWith(href)); %>
            <a href="<%= href %>" class="nav-link flex items-center px-3 py-2 rounded-xl text-slate-700 hover:bg-sky-50 hover:text-sky-700 transition group <%= active ? 'active' : '' %>">
              <span class="nav-text truncate"><%= label %></span>
            </a>
          <% }) %>
        </div>
      </div>

      <!-- Group 4: System & Security -->
      <div>
        <div class="nav-section-title px-3 py-1 text-[10px] font-mono uppercase tracking-widest text-sky-700 font-extrabold">🛡️ System & Audit</div>
        <div class="space-y-0.5 mt-1">
          <% const group4 = [
            ['/audit', '📜 Audit Trail'],
            ['/maintenance', '🛠 Maintenance Mode'],
            ['/status', '⚙️ Server Telemetry'],
          ]; %>
          <% group4.forEach(function(l){ var href=l[0], label=l[1];
             var active = (currentPath === href) || (href !== '/' && currentPath.startsWith(href)); %>
            <a href="<%= href %>" class="nav-link flex items-center px-3 py-2 rounded-xl text-slate-700 hover:bg-sky-50 hover:text-sky-700 transition group <%= active ? 'active' : '' %>">
              <span class="nav-text truncate"><%= label %></span>
            </a>
          <% }) %>
        </div>
      </div>
    </nav>

    <!-- Sidebar Bottom Status & Logout -->
    <div class="p-3 border-t border-sky-100 bg-sky-50/50">
      <div class="sidebar-footer flex items-center justify-between mb-2 px-1 text-[11px] text-sky-700 font-mono">
        <span class="flex items-center gap-1.5 font-bold">
          <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>SYSTEM ACTIVE</span>
        </span>
        <span class="text-slate-500 font-semibold">v10.07 PRO</span>
      </div>
      <form method="post" action="/logout">
        <button class="w-full text-left px-3 py-2 rounded-xl text-rose-600 hover:text-rose-700 hover:bg-rose-50 text-xs font-semibold transition flex items-center justify-between border border-rose-200">
          <span class="logout-text font-medium">↪ Logout Session</span>
          <span>🛡</span>
        </button>
      </form>
    </div>
  </aside>

  <!-- Main Content Viewport -->
  <main class="flex-1 min-w-0 flex flex-col overflow-y-auto">
    <!-- Top Enterprise Navigation Bar -->
    <header class="h-14 border-b border-sky-200/70 bg-white/90 backdrop-blur-xl px-4 sm:px-6 flex items-center justify-between shrink-0 sticky top-0 z-20 shadow-xs">
      <div class="flex items-center gap-3">
        <div class="flex items-center gap-2 text-xs font-mono font-bold text-sky-800 bg-sky-50 border border-sky-200 px-3 py-1 rounded-lg">
          <span class="h-2 w-2 rounded-full bg-sky-500 animate-ping"></span>
          <span>🕒 <span id="live-time">--:--:--</span></span>
        </div>
        <div class="hidden sm:flex items-center gap-2 text-[11px] text-slate-500 font-mono">
          <span class="text-sky-300">|</span>
          <span class="flex items-center gap-1 text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 font-semibold"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span> VPS Online</span>
          <span class="text-sky-300">|</span>
          <span class="text-sky-700 font-semibold">SQLite Protected</span>
        </div>
      </div>

      <!-- Quick Action Badges -->
      <div class="flex items-center gap-2 sm:gap-3">
        <a href="/orders" class="px-3 py-1 text-xs font-bold rounded-lg bg-sky-50 hover:bg-sky-100 text-sky-700 border border-sky-200 transition flex items-center gap-1.5 shadow-xs">
          <span>📥 Orders (25/P)</span>
        </a>
        <a href="/replace" class="px-3 py-1 text-xs font-bold rounded-lg bg-sky-50 hover:bg-sky-100 text-sky-700 border border-sky-200 transition flex items-center gap-1.5 shadow-xs">
          <span>🔄 Replaces</span>
        </a>
        <div class="h-8 w-8 rounded-full bg-gradient-to-tr from-sky-500 to-blue-600 flex items-center justify-center font-bold text-white text-xs border border-sky-200 shadow-sm" title="Super Admin">
          A
        </div>
      </div>
    </header>

    <!-- Top banner message if present -->
    <% if (typeof msg !== 'undefined' && msg) { %>
      <div class="bg-gradient-to-r from-sky-500 to-blue-600 text-white px-6 py-2.5 text-xs font-semibold flex items-center gap-2 shadow-md shrink-0">
        <span class="h-2 w-2 rounded-full bg-white animate-pulse"></span>
        <span><%= msg %></span>
      </div>
    <% } %>

    <!-- Fluid full-width container with clean responsive padding -->
    <div class="w-full px-4 sm:px-6 lg:px-8 py-6">

<script>
  function toggleSidebar() {
    document.body.classList.toggle('sidebar-collapsed');
    localStorage.setItem('dsh_sidebar_collapsed', document.body.classList.contains('sidebar-collapsed') ? '1' : '0');
  }
  if (localStorage.getItem('dsh_sidebar_collapsed') === '1') {
    document.body.classList.add('sidebar-collapsed');
  }

  // Live Dhaka Clock
  function updateClock() {
    const now = new Date();
    const timeStr = now.toLocaleTimeString('en-US', { timeZone: 'Asia/Dhaka', hour12: true, hour: '2-digit', minute: '2-digit', second: '2-digit' });
    const el = document.getElementById('live-time');
    if (el) el.innerText = timeStr + ' BST';
  }
  updateClock();
  setInterval(updateClock, 1000);
</script>
