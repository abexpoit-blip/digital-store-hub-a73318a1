<%- include('partials/header', { title: 'Buy Limit', msg, currentPath }) %>

<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-2xl font-bold">⏱ Buy Limit</h1>
    <div class="text-xs text-slate-400 mt-1">FB 1000xx purchase limit — web panel থেকেই ON/OFF</div>
  </div>
  <form method="post" action="/buylimit/toggle" class="flex items-center gap-2">
    <span class="px-2 py-1 rounded text-xs <%= enabled ? 'bg-emerald-700/40 text-emerald-300' : 'bg-rose-700/40 text-rose-300' %>">
      <%= enabled ? 'ON' : 'OFF' %>
    </span>
    <input type="hidden" name="state" value="<%= enabled ? 'off' : 'on' %>"/>
    <button class="text-xs px-3 py-1.5 rounded <%= enabled ? 'bg-rose-600 hover:bg-rose-500' : 'bg-emerald-600 hover:bg-emerald-500' %> text-white">
      <%= enabled ? 'Turn OFF' : 'Turn ON' %>
    </button>
  </form>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
  <div class="bg-slate-900 border border-slate-800 p-5 rounded-xl lg:col-span-2">
    <div class="text-sm font-semibold mb-3">⚙️ Limit Settings</div>
    <form method="post" action="/buylimit/save" class="space-y-3">
      <div class="grid grid-cols-2 gap-3">
        <label class="block">
          <span class="text-xs text-slate-400">Max pcs / window</span>
          <input type="number" name="max" min="1" max="100000" value="<%= max %>" required
                 class="w-full mt-1 bg-slate-800 border border-slate-700 rounded px-2 py-1.5 text-sm"/>
        </label>
        <label class="block">
          <span class="text-xs text-slate-400">Window (মিনিট)</span>
          <input type="number" name="window_min" min="1" max="1440" value="<%= windowMin %>" required
                 class="w-full mt-1 bg-slate-800 border border-slate-700 rounded px-2 py-1.5 text-sm"/>
        </label>
      </div>
      <label class="block">
        <span class="text-xs text-slate-400">Limited categories (comma separated) — বাকি সব unlimited</span>
        <input type="text" name="cats" value="<%= cats %>" required
               class="w-full mt-1 bg-slate-800 border border-slate-700 rounded px-2 py-1.5 text-sm font-mono"/>
      </label>
      <button class="bg-cyan-600 hover:bg-cyan-500 text-white text-sm px-4 py-1.5 rounded">Save</button>
    </form>
    <div class="text-xs text-slate-500 mt-3">
      বর্তমান নিয়ম: <span class="text-slate-300"><%= max %> pcs / <%= windowMin %> মিনিট</span>
      <%= enabled ? '' : ' — এখন OFF, তাই কোনো limit নেই' %>
    </div>
  </div>

  <div class="bg-slate-900 border border-slate-800 p-5 rounded-xl">
    <div class="text-sm font-semibold mb-3">♻️ Reset</div>
    <form method="post" action="/buylimit/reset" class="space-y-2 mb-4">
      <input type="text" name="user_id" placeholder="Telegram user id" required
             class="w-full bg-slate-800 border border-slate-700 rounded px-2 py-1.5 text-sm"/>
      <button class="w-full bg-slate-700 hover:bg-slate-600 text-white text-sm py-1.5 rounded">Reset this user</button>
    </form>
    <form method="post" action="/buylimit/reset-all" onsubmit="return confirm('সবার limit reset করবেন?')">
      <button class="w-full bg-amber-700 hover:bg-amber-600 text-white text-sm py-1.5 rounded">Reset all users</button>
    </form>
  </div>
</div>

<div class="bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">
  <div class="px-5 py-3 border-b border-slate-800 text-sm font-semibold">🔥 Active windows</div>
  <table class="w-full text-sm">
    <thead><tr><th>User</th><th>Used</th><th>Time left</th><th></th></tr></thead>
    <tbody>
      <% if (!active.length) { %>
        <tr><td colspan="4" class="text-center text-slate-500 py-6">কোনো active window নেই।</td></tr>
      <% } %>
      <% active.forEach(function(a){ %>
        <tr>
          <td><a href="/users/<%= a.user_id %>" class="text-cyan-400 hover:underline"><%= a.username || a.user_id %></a></td>
          <td class="font-mono <%= a.count >= max ? 'text-rose-400' : 'text-emerald-400' %>"><%= a.count %>/<%= max %></td>
          <td class="text-slate-400"><%= Math.floor(a.left / 60) %>m <%= a.left % 60 %>s</td>
          <td class="text-right">
            <form method="post" action="/buylimit/reset">
              <input type="hidden" name="user_id" value="<%= a.user_id %>"/>
              <button class="text-xs px-2 py-1 bg-slate-800 hover:bg-slate-700 rounded">Reset</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('partials/footer') %>
