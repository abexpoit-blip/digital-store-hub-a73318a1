<%- include('partials/header', { title: 'Orders History', msg: null, currentPath }) %>

<!-- Header Bar -->
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 flex items-center gap-2.5">
      <span>📥 Orders History</span>
      <span class="text-xs font-mono font-bold bg-sky-50 text-sky-700 border border-sky-200 px-2.5 py-0.5 rounded-full shadow-xs">
        <%= totalCount.toLocaleString() %> Total
      </span>
    </h1>
    <p class="text-xs text-slate-500 mt-1">Real-time ledger of completed sales, automated file downloads & customer order tracking</p>
  </div>
  <div class="flex items-center gap-2">
    <span class="text-xs text-slate-600 font-mono bg-white border border-sky-200 px-3 py-1.5 rounded-xl shadow-xs">
      Showing 25 / page (Page <%= page %> of <%= totalPages %>)
    </span>
  </div>
</div>

<!-- Search Bar & Filters -->
<div class="commercial-card p-4 rounded-2xl mb-6 bg-white border border-sky-200 shadow-sm">
  <form method="get" action="/orders" class="flex flex-col sm:flex-row items-center gap-3">
    <div class="relative flex-1 w-full">
      <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-sky-500">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
      </div>
      <input name="q" value="<%= q %>" placeholder="Search by Username, User ID, or Category (e.g. fb1000, bmfb)..."
        class="w-full bg-slate-50 border border-slate-200 focus:border-sky-500 focus:bg-white rounded-xl pl-10 pr-4 py-2.5 text-xs placeholder-slate-400 text-slate-800 outline-none transition"/>
    </div>
    <div class="flex items-center gap-2 w-full sm:w-auto">
      <button type="submit" class="w-full sm:w-auto bg-gradient-to-r from-sky-500 to-sky-600 hover:from-sky-600 hover:to-sky-700 text-white font-bold px-6 py-2.5 rounded-xl text-xs shadow-md shadow-sky-500/25 flex items-center justify-center gap-1.5 transition">
        <span>🔍</span> Search Orders
      </button>
      <% if (q) { %>
        <a href="/orders" class="px-3.5 py-2.5 text-xs text-slate-600 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 border border-slate-200 rounded-xl transition">
          Clear
        </a>
      <% } %>
    </div>
  </form>
</div>

<!-- Orders Table Card -->
<div class="commercial-card rounded-2xl overflow-hidden mb-6 bg-white border border-sky-200 shadow-sm">
  <div class="overflow-x-auto">
    <table class="w-full text-xs">
      <thead>
        <tr class="border-b border-sky-100 bg-sky-50/90 text-sky-800 font-mono text-[11px] tracking-wider uppercase font-bold">
          <th class="py-3.5 px-4">Order ID</th>
          <th class="py-3.5 px-4">Customer</th>
          <th class="py-3.5 px-4">Category</th>
          <th class="py-3.5 px-4 text-center">Quantity</th>
          <th class="py-3.5 px-4">Total Amount</th>
          <th class="py-3.5 px-4">Purchase Date & Time</th>
          <th class="py-3.5 px-4 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-sky-100">
        <% if (!sales.length) { %>
          <tr>
            <td colspan="7" class="text-center text-slate-400 py-12">
              <div class="text-3xl mb-2">📭</div>
              <div class="text-sm font-medium">কোনো অর্ডার পাওয়া যায়নি।</div>
            </td>
          </tr>
        <% } %>
        <% sales.forEach(function(s){ %>
          <tr class="hover:bg-sky-50/50 transition">
            <td class="py-3.5 px-4 font-mono text-sky-600 font-bold">#<%= s.id %></td>
            <td class="py-3.5 px-4">
              <a href="/users/<%= s.user_id %>" class="text-slate-900 hover:text-sky-600 font-semibold block transition">
                <%= s.username || ('User ' + s.user_id) %>
              </a>
              <div class="text-[10px] text-slate-400 font-mono">ID: `<%= s.user_id %>`</div>
            </td>
            <td class="py-3.5 px-4">
              <span class="inline-block px-2.5 py-1 rounded-lg font-mono text-[11px] font-semibold bg-sky-50 text-sky-700 border border-sky-200 shadow-xs">
                <%= s.category %>
              </span>
            </td>
            <td class="py-3.5 px-4 text-center font-mono text-slate-800 font-bold text-xs">
              <span class="bg-sky-50 text-sky-800 px-2 py-0.5 rounded border border-sky-200">
                <%= s.qty %> pcs
              </span>
            </td>
            <td class="py-3.5 px-4 font-mono font-bold text-emerald-600 text-xs">
              <%= s.total %>৳
            </td>
            <td class="py-3.5 px-4 text-slate-500 text-[11px] whitespace-nowrap">
              <div class="text-slate-800 font-medium"><%= s.date %></div>
              <div class="text-slate-400 text-[10px]"><%= s.time || '' %></div>
            </td>
            <td class="py-3.5 px-4 text-right whitespace-nowrap">
              <a href="/orders/<%= s.id %>/excel"
                 class="inline-flex items-center gap-1.5 bg-sky-50 hover:bg-sky-100 text-sky-700 border border-sky-200 px-3 py-1.5 rounded-xl text-xs font-bold transition shadow-xs">
                <span>⬇</span> Excel (.xlsx)
              </a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- Commercial Pagination Toolbar (Next, Prev, 1, 2, 3...) -->
<% if (totalPages > 1) { %>
  <div class="flex flex-col sm:flex-row items-center justify-between gap-4 commercial-card p-4 rounded-2xl bg-white border border-sky-200 shadow-sm">
    <div class="text-xs text-slate-600">
      Showing <span class="font-bold text-slate-900"><%= ((page - 1) * limit) + 1 %></span> to <span class="font-bold text-slate-900"><%= Math.min(page * limit, totalCount) %></span> of <span class="font-bold text-slate-900"><%= totalCount %></span> records
    </div>

    <div class="flex items-center gap-1.5">
      <!-- Previous Page Button -->
      <% if (page > 1) { %>
        <a href="/orders?page=<%= page - 1 %><%= q ? '&q=' + encodeURIComponent(q) : '' %>"
           class="px-3 py-1.5 rounded-xl text-xs font-bold bg-white text-slate-700 border border-sky-200 hover:bg-sky-50 hover:text-sky-700 transition flex items-center gap-1 shadow-xs">
          ‹ Prev
        </a>
      <% } else { %>
        <span class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-50 text-slate-400 border border-slate-200 cursor-not-allowed">
          ‹ Prev
        </span>
      <% } %>

      <!-- Numbered Page Buttons -->
      <% 
        let startPage = Math.max(1, page - 2);
        let endPage = Math.min(totalPages, startPage + 4);
        if (endPage - startPage < 4) {
          startPage = Math.max(1, endPage - 4);
        }
      %>

      <% if (startPage > 1) { %>
        <a href="/orders?page=1<%= q ? '&q=' + encodeURIComponent(q) : '' %>"
           class="w-8 h-8 rounded-xl text-xs font-semibold flex items-center justify-center bg-white text-slate-700 border border-sky-200 hover:bg-sky-50 hover:text-sky-700 transition shadow-xs">
          1
        </a>
        <% if (startPage > 2) { %>
          <span class="text-slate-400 px-1 text-xs">…</span>
        <% } %>
      <% } %>

      <% for (let p = startPage; p <= endPage; p++) { %>
        <% if (p === page) { %>
          <span class="w-8 h-8 rounded-xl text-xs font-bold flex items-center justify-center bg-gradient-to-tr from-sky-500 to-sky-600 text-white shadow-md shadow-sky-500/30 border border-sky-400">
            <%= p %>
          </span>
        <% } else { %>
          <a href="/orders?page=<%= p %><%= q ? '&q=' + encodeURIComponent(q) : '' %>"
             class="w-8 h-8 rounded-xl text-xs font-semibold flex items-center justify-center bg-white text-slate-700 border border-sky-200 hover:bg-sky-50 hover:text-sky-700 transition shadow-xs">
            <%= p %>
          </a>
        <% } %>
      <% } %>

      <% if (endPage < totalPages) { %>
        <% if (endPage < totalPages - 1) { %>
          <span class="text-slate-400 px-1 text-xs">…</span>
        <% } %>
        <a href="/orders?page=<%= totalPages %><%= q ? '&q=' + encodeURIComponent(q) : '' %>"
           class="w-8 h-8 rounded-xl text-xs font-semibold flex items-center justify-center bg-white text-slate-700 border border-sky-200 hover:bg-sky-50 hover:text-sky-700 transition shadow-xs">
          <%= totalPages %>
        </a>
      <% } %>

      <!-- Next Page Button -->
      <% if (page < totalPages) { %>
        <a href="/orders?page=<%= page + 1 %><%= q ? '&q=' + encodeURIComponent(q) : '' %>"
           class="px-3 py-1.5 rounded-xl text-xs font-bold bg-white text-slate-700 border border-sky-200 hover:bg-sky-50 hover:text-sky-700 transition flex items-center gap-1 shadow-xs">
          Next ›
        </a>
      <% } else { %>
        <span class="px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-50 text-slate-400 border border-slate-200 cursor-not-allowed">
          Next ›
        </span>
      <% } %>
    </div>
  </div>
<% } %>

<%- include('partials/footer') %>
