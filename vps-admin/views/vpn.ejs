<%- include('partials/header', { title: 'VPN Pricing & Management', msg, currentPath }) %>

<div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900 flex items-center gap-2.5">
      <span>🛡️ VPN Pricing & Inventory</span>
      <span class="text-xs font-mono font-bold bg-sky-50 text-sky-700 border border-sky-200 px-2.5 py-0.5 rounded-full shadow-xs">
        Live Catalog
      </span>
    </h1>
    <p class="text-xs text-slate-500 mt-1">
      Manage selling prices and view automated API linkages. Changes update in Telegram bot in real-time.
    </p>
  </div>
  <div class="flex items-center gap-3">
    <!-- Global Service Toggle -->
    <form method="post" action="/vpn/toggle" class="inline">
      <input type="hidden" name="state" value="<%= serviceOn ? 'off' : 'on' %>"/>
      <button class="px-4 py-2 rounded-xl text-xs font-bold transition shadow-xs flex items-center gap-2 <%= serviceOn ? 'bg-emerald-50 text-emerald-800 border border-emerald-300 hover:bg-emerald-100' : 'bg-rose-50 text-rose-800 border border-rose-300 hover:bg-rose-100' %>">
        <span class="w-2.5 h-2.5 rounded-full <%= serviceOn ? 'bg-emerald-500 animate-pulse' : 'bg-rose-500' %>"></span>
        <span><%= serviceOn ? '✅ VPN Service: ACTIVE' : '⛔ VPN Service: PAUSED' %></span>
      </button>
    </form>
    <a href="/vpnapi" class="bg-gradient-to-r from-sky-500 to-sky-600 hover:from-sky-600 hover:to-sky-700 text-white px-4 py-2 rounded-xl text-xs font-bold transition shadow-xs flex items-center gap-1.5">
      <span>🔌</span> Provider API Hub
    </a>
  </div>
</div>

<!-- Add / Update Package Form Card -->
<div class="commercial-card rounded-2xl p-5 bg-white border border-sky-200 shadow-xs mb-6">
  <div class="flex items-center justify-between mb-4 pb-3 border-b border-sky-100">
    <div class="flex items-center gap-2">
      <span class="text-lg">➕</span>
      <h2 class="text-sm font-bold text-slate-900">Add or Update Package Price</h2>
    </div>
    <div class="text-xs text-slate-400 font-mono">Total Configured Packages: <b class="text-slate-800"><%= totalPkgs %></b></div>
  </div>

  <form method="post" action="/vpn/save" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-12 gap-3 items-end">
    <div class="md:col-span-4">
      <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
        VPN Brand ID
      </label>
      <input name="vpn_id" required placeholder="e.g. potato, nord, express" list="brandlist"
             class="w-full bg-slate-50 border border-slate-200 focus:border-sky-500 focus:bg-white rounded-xl px-3.5 py-2 text-xs font-mono text-slate-800 outline-none transition"/>
      <datalist id="brandlist">
        <% brands.forEach(function(b){ %><option value="<%= b.vpn_id %>"><%= b.name %></option><% }) %>
      </datalist>
    </div>

    <div class="md:col-span-3">
      <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
        Package Duration ID
      </label>
      <input name="pkg_id" required placeholder="e.g. 7d, 30d, 1m"
             class="w-full bg-slate-50 border border-slate-200 focus:border-sky-500 focus:bg-white rounded-xl px-3.5 py-2 text-xs font-mono text-slate-800 outline-none transition"/>
    </div>

    <div class="md:col-span-3">
      <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">
        Selling Price (BDT ৳)
      </label>
      <input name="price" type="number" min="0" max="1000000" required placeholder="30"
             class="w-full bg-slate-50 border border-slate-200 focus:border-sky-500 focus:bg-white rounded-xl px-3.5 py-2 text-xs font-bold text-slate-800 outline-none transition"/>
    </div>

    <div class="md:col-span-2">
      <button type="submit" class="w-full bg-gradient-to-r from-emerald-500 to-emerald-600 hover:from-emerald-600 hover:to-emerald-700 text-white font-bold py-2 rounded-xl text-xs transition shadow-xs">
        💾 Save Price
      </button>
    </div>
  </form>
</div>

<% if (!brands.length) { %>
  <div class="text-center text-slate-400 py-12 commercial-card bg-white border border-sky-200 rounded-2xl shadow-xs">
    <div class="text-3xl mb-2">📭</div>
    <div class="font-medium">কোনো VPN প্যাকেজ সেট নেই — উপরের ফর্ম ব্যবহার করে নতুন প্যাকেজ যোগ করুন।</div>
  </div>
<% } %>

<!-- Brands List -->
<div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
  <% brands.forEach(function(b){ %>
    <div class="commercial-card rounded-2xl overflow-hidden bg-white border border-sky-200 shadow-sm flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between px-5 py-3.5 border-b border-sky-100 bg-sky-50/70">
          <div class="font-bold text-slate-900 text-sm flex items-center gap-2">
            <span>🌐 <%= b.name %></span>
            <span class="text-[11px] font-mono text-sky-700 bg-sky-100 px-2 py-0.5 rounded-md"><%= b.vpn_id %></span>
          </div>
          <form method="post" action="/vpn/delete-brand"
                onsubmit="return confirm('<%= b.name %> এর সব প্যাকেজ ডিলিট করবেন?');">
            <input type="hidden" name="vpn_id" value="<%= b.vpn_id %>"/>
            <button class="text-xs text-rose-600 hover:text-rose-800 font-bold">🗑️ Delete Brand</button>
          </form>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-xs">
            <thead>
              <tr class="border-b border-sky-100 bg-sky-50/40 text-sky-900 font-mono text-[10px] tracking-wider uppercase font-bold">
                <th class="py-2.5 px-4 text-left">Package</th>
                <th class="py-2.5 px-3 text-left">API Link</th>
                <th class="py-2.5 px-3 text-left">Selling Price</th>
                <th class="py-2.5 px-4 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-sky-100">
              <% b.items.forEach(function(it){ %>
                <tr class="hover:bg-sky-50/50 transition">
                  <td class="py-2.5 px-4 font-bold text-slate-800">
                    <%= it.pkg_label %>
                    <span class="text-[10px] text-slate-400 font-mono ml-1">(<%= it.pkg_id %>)</span>
                  </td>
                  <td class="py-2.5 px-3">
                    <% if (it.apiService) { %>
                      <span class="inline-flex items-center gap-1 text-[10px] font-bold px-2 py-0.5 rounded bg-emerald-50 text-emerald-700 border border-emerald-200">
                        <span>⚡</span> API #<%= it.apiService %>
                        <span class="text-slate-400 font-mono">(<%= it.apiCost %>৳)</span>
                      </span>
                    <% } else { %>
                      <span class="text-[10px] text-slate-400">Manual / Stock</span>
                    <% } %>
                  </td>
                  <td class="py-2.5 px-3 font-mono font-extrabold text-slate-900">
                    <%= it.price %>৳
                  </td>
                  <td class="py-2.5 px-4 text-right whitespace-nowrap">
                    <div class="flex items-center justify-end gap-1.5">
                      <form method="post" action="/vpn/save" class="inline-flex items-center gap-1">
                        <input type="hidden" name="vpn_id" value="<%= b.vpn_id %>"/>
                        <input type="hidden" name="pkg_id" value="<%= it.pkg_id %>"/>
                        <input name="price" type="number" min="0" max="1000000" value="<%= it.price %>"
                               class="w-16 bg-slate-50 border border-slate-200 rounded-lg px-2 py-1 text-xs font-bold text-slate-800 text-center"/>
                        <button class="bg-sky-50 hover:bg-sky-100 text-sky-700 border border-sky-200 px-2 py-1 rounded-lg text-xs font-bold">Save</button>
                      </form>
                      <form method="post" action="/vpn/delete" onsubmit="return confirm('Delete <%= b.name %> · <%= it.pkg_label %>?');" class="inline">
                        <input type="hidden" name="vpn_id" value="<%= b.vpn_id %>"/>
                        <input type="hidden" name="pkg_id" value="<%= it.pkg_id %>"/>
                        <button class="text-rose-500 hover:text-rose-700 p-1 text-xs font-bold">✕</button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% }) %>
</div>

<%- include('partials/footer') %>
